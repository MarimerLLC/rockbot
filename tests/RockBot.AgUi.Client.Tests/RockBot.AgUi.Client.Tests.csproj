<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.*" />
    <PackageReference Include="MSTest.TestFramework" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\RockBot.AgUi.Client\RockBot.AgUi.Client.csproj" />
    <!-- The real proxy with an in-process bus and the demo agent, for the end-to-end tests. -->
    <ProjectReference Include="..\..\samples\RockBot.AgUi.DevHost\RockBot.AgUi.DevHost.csproj" />
    <!-- Test-only: the proxy's own event names, to check the client's copy against. -->
    <ProjectReference Include="..\..\src\RockBot.UserProxy.AgUi.Events\RockBot.UserProxy.AgUi.Events.csproj" />
    <!-- Test-only: WellKnownSessions, to check the client's session ids against the agent's. -->
    <ProjectReference Include="..\..\src\RockBot.Host.Abstractions\RockBot.Host.Abstractions.csproj" />
  </ItemGroup>

</Project>
