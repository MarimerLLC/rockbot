{
  "McpBridge": {
    "ConfigPath": "mcp.json"
  },
  "Dream": {
    "CronSchedule": "0 */12 * * *"
  },
  "MemoryAudit": {
    "CronSchedule": "0 4 * * *"
  },
  "ModelBehaviors": {
    "BasePath": "model-behaviors",
    "Models": {
      "deepseek": {
        "NudgeOnHallucinatedToolCalls": true,
        "ScheduledTaskResultMode": "VerbatimOutput",
        "UseTextBasedToolCalling": true
      },
      "claude": {
        "MaxToolIterationsOverride": 25
      },
      "gpt": {
        "NudgeOnLeakedToolSyntax": true,
        "NudgeOnUnexpectedCjkOutput": true
      }
    }
  }
}
