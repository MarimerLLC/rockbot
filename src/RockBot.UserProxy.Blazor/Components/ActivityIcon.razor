@* One header activity slot (RockBot Design System "ActivityIcon"). Every slot is always drawn, in a
   fixed order: the row of slots is the status map, so an idle slot dims instead of disappearing.
   The ring glow and pulse are reserved for live activity — the only glow allowed in product chrome. *@

@{
    var spec = Specs[Kind];
    var showCount = Active && Count > 1;
}
<span class="activity-icon @(Active ? "active" : null)" style="--ring: @spec.Ring; --glow: @spec.Glow"
      title="@(Title ?? spec.Label)">
    <span class="activity-icon-inner"><RbIcon Name="@spec.Icon" Size="@spec.Size" /></span>
    @if (showCount)
    {
        <span class="activity-icon-count" aria-hidden="true">@Count</span>
    }
    <span class="visually-hidden">@spec.Label: @(Active ? showCount ? $"{Count} active" : "active" : "idle")</span>
</span>

@code {
    /// <summary><c>agent</c>, <c>subagent</c>, <c>a2a</c> or <c>scheduled</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "agent";

    [Parameter] public bool Active { get; set; }

    /// <summary>Concurrent instances; a badge shows it when more than one is active.</summary>
    [Parameter] public int Count { get; set; }

    /// <summary>Tooltip; defaults to the slot's label.</summary>
    [Parameter] public string? Title { get; set; }

    private sealed record Spec(string Icon, int Size, string Ring, string Glow, string Label);

    // Ring colours from the design system's ACTIVITY_SPECS: agent --rb-orange, subagent
    // --rb-orange-300, A2A --rb-eye-glow, scheduled --rb-warning.
    private static readonly Dictionary<string, Spec> Specs = new(StringComparer.Ordinal)
    {
        ["agent"] = new("robot", 14, "var(--rb-orange)", "rgba(255, 122, 26, 0.55)", "RockBot"),
        ["subagent"] = new("robot", 14, "var(--rb-orange-300)", "rgba(255, 155, 77, 0.50)", "Subagents"),
        ["a2a"] = new("exchange", 13, "var(--rb-eye-glow)", "rgba(58, 184, 255, 0.55)", "Inbound A2A"),
        ["scheduled"] = new("hourglass", 13, "var(--rb-warning)", "rgba(251, 191, 36, 0.55)", "Background tasks"),
    };
}
