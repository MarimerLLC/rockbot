@* One header activity slot (RockBot Design System "ActivityIcon"). Every slot is always drawn, in a
   fixed order: the row of slots is the status map, so an idle slot dims instead of disappearing.
   The ring glow and pulse are reserved for live activity — the only glow allowed in product chrome.
   The glyph is the kind's own (CategoryAvatar.Glyph) and the ring colour comes from app.css
   (.activity-icon.<kind>), so the header slot and the bubble avatar can't drift apart.
   With OnClick the slot is a button that opens the activity panel on its tab (#828). *@

@{
    var label = Label(Kind);
    var showCount = Active && Count > 1;
    var state = Active ? showCount ? $"{Count} active" : "active" : "idle";
}
@if (OnClick.HasDelegate)
{
    <button type="button" class="activity-icon @Kind @(Active ? "active" : null)" title="@(Title ?? label)"
            aria-expanded="@(Expanded ? "true" : "false")" aria-controls="@Controls" @onclick="OnClick">
        <span class="activity-icon-inner"><RbIcon Name="@CategoryAvatar.Glyph(Kind)" Size="@(Kind is "agent" or "subagent" ? 14 : 13)" /></span>
        @if (showCount)
        {
            <span class="activity-icon-count" aria-hidden="true">@Count</span>
        }
        <span class="visually-hidden">@label: @state. Show details</span>
    </button>
}
else
{
    <span class="activity-icon @Kind @(Active ? "active" : null)" title="@(Title ?? label)">
        <span class="activity-icon-inner"><RbIcon Name="@CategoryAvatar.Glyph(Kind)" Size="@(Kind is "agent" or "subagent" ? 14 : 13)" /></span>
        @if (showCount)
        {
            <span class="activity-icon-count" aria-hidden="true">@Count</span>
        }
        <span class="visually-hidden">@label: @state</span>
    </span>
}

@code {
    /// <summary><c>agent</c>, <c>subagent</c>, <c>a2a</c> or <c>scheduled</c>.</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "agent";

    [Parameter] public bool Active { get; set; }

    /// <summary>Concurrent instances; a badge shows it when more than one is active.</summary>
    [Parameter] public int Count { get; set; }

    /// <summary>Tooltip; defaults to the slot's label.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Makes the slot a button: opens (or closes) the activity panel on this slot's tab.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>True while the activity panel shows this slot's tab.</summary>
    [Parameter] public bool Expanded { get; set; }

    /// <summary>The activity panel's id.</summary>
    [Parameter] public string? Controls { get; set; }

    private static string Label(string kind) => kind switch
    {
        "agent" => "RockBot",
        "subagent" => "Subagents",
        "a2a" => "Inbound A2A",
        "scheduled" => "Background tasks",
        _ => throw new ArgumentException($"Unknown activity kind '{kind}'.", nameof(Kind)),
    };
}
