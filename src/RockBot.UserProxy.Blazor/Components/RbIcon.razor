@* One monochrome stroke icon, drawn in currentColor so it takes the colour of whatever holds it.
   The design system allows no emoji in the UI (the 🌙/☀️ theme toggle is the one exception), so
   every glyph the chat needs lives here. Always decorative: the button or link around it carries
   the accessible name.

   The robot, hourglass, exchange, bookmark, copy and send glyphs are the RockBot Design System's
   own. The rest are Lucide icons (https://lucide.dev, ISC licence, Copyright (c) Lucide Contributors). *@

@{
    // An unknown name is a typo in markup, not data: fail on first render rather than draw a
    // stand-in glyph that could read as the wrong action.
    var icon = Icons.TryGetValue(Name, out var found)
        ? found
        : throw new ArgumentException($"Unknown icon '{Name}'.", nameof(Name));
}
<svg class="rb-icon @Class" viewBox="@icon.ViewBox" width="@Size" height="@Size"
     fill="@(Filled ? "currentColor" : "none")" stroke="currentColor" stroke-width="@icon.Stroke"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">@((MarkupString)icon.Body)</svg>

@code {
    /// <summary>The icon's name, a key of <see cref="Icons"/>.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>Rendered width and height in pixels.</summary>
    [Parameter] public int Size { get; set; } = 16;

    /// <summary>Fills the shape as well as stroking it (the saved bookmark).</summary>
    [Parameter] public bool Filled { get; set; }

    [Parameter] public string? Class { get; set; }

    private sealed record IconDef(string ViewBox, string Stroke, string Body);

    // Constant markup only: nothing here comes from a message or the user.
    private static readonly Dictionary<string, IconDef> Icons = new(StringComparer.Ordinal)
    {
        // RockBot Design System glyphs.
        ["robot"] = new("0 0 20 20", "1.6",
