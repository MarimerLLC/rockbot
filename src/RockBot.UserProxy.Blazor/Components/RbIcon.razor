            "<circle cx=\"8\" cy=\"10\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"/><circle cx=\"12\" cy=\"10\" r=\"1.2\" fill=\"currentColor\" stroke=\"none\"/>" +
            "<line x1=\"7.5\" y1=\"13\" x2=\"12.5\" y2=\"13\"/>"),
        ["hourglass"] = new("0 0 20 20", "1.6",
