@* The agent info dialog (#834): what the agent is and what it is configured with, read straight
   from the agent over the bus without invoking its LLM. Tabs: Agent, Models, Pricing. A modal like
   the saved-responses dialog: the chat page makes everything behind it inert while it is open. *@
@using RockBot.UserProxy.Blazor.Services
@inject UserProxyService ProxyService

<div class="modal-overlay" @onclick="OnClose">
    <div class="info-modal" role="dialog" aria-modal="true" aria-labelledby="rb-info-title" tabindex="-1"
         @ref="_dialog" @onkeydown="OnKeyDown" @onclick:stopPropagation="true">
        <div class="info-modal-head">
            <h2 id="rb-info-title" class="info-modal-title">@(_info?.AgentName ?? AgentName ?? "RockBot")</h2>
            <button type="button" class="row-icon-btn" title="Refresh" aria-label="Refresh agent info"
                    disabled="@_loading" @onclick="LoadAsync">
                <RbIcon Name="refresh-cw" Size="14" Class="@(_loading ? "info-spin" : null)" />
            </button>
            <button type="button" class="row-icon-btn" title="Close" aria-label="Close agent info" @onclick="OnClose">
                <RbIcon Name="x" Size="15" />
            </button>
        </div>

        <div class="info-tabs" role="tablist" aria-label="Agent info">
            @foreach (var tab in Tabs)
            {
                <button type="button" role="tab" id="@TabId(tab)" class="activity-tab info-tab"
                        aria-selected="@(tab == _tab ? "true" : "false")" aria-controls="rb-info-panel"
                        tabindex="@(tab == _tab ? 0 : -1)"
                        @ref="_tabRefs[(int)tab]" @onclick="() => _tab = tab">
                    @TabLabel(tab)
                </button>
            }
        </div>

        <div class="info-panel" role="tabpanel" id="rb-info-panel" aria-labelledby="@TabId(_tab)" aria-busy="@(_loading ? "true" : "false")">
            @if (_loading && _info is null)
            {
                <p class="activity-empty">Asking the agent…</p>
            }
            else if (_info is null && _tab != Tab.Agent)
            {
                <p class="info-unavailable">@UnavailableText</p>
            }
            else if (_tab == Tab.Agent)
            {
                @AgentTab
            }
            else if (_tab == Tab.Models)
            {
                @ModelsTab(_info!.Models)
            }
            else if (_tab == Tab.Pricing)
            {
                @PricingTab(_info!.Pricing)
            }
            else if (_tab == Tab.Usage)
            {
                @UsageTab(_info!.Usage)
            }
            else if (_tab == Tab.Mcp)
            {
                @McpTab(_info!.Mcp)
            }
            else if (_tab == Tab.Skills)
            {
                @SkillsTab(_info!.Skills)
            }
            else if (_tab == Tab.Memory)
            {
                @MemoryTab(_info!.Memory)
            }
            else
            {
                @RoutingTab(_info!.Routing)
            }
        </div>
    </div>
</div>

@code {
    private enum Tab { Agent, Models, Pricing, Usage, Mcp, Skills, Memory, Routing }

    private static readonly Tab[] Tabs = [Tab.Agent, Tab.Models, Tab.Pricing, Tab.Usage, Tab.Mcp, Tab.Skills, Tab.Memory, Tab.Routing];

    [Parameter] public string? AgentName { get; set; }

    /// <summary>The agent version from the page's info request, shown while the dialog's own request is out.</summary>
    [Parameter] public string? AgentVersion { get; set; }

    [Parameter, EditorRequired] public string AppVersion { get; set; } = "";

    [Parameter] public TimeZoneInfo DisplayZone { get; set; } = TimeZoneInfo.Utc;

    /// <summary>The chat's thread (raw session id): the Usage tab shows its own totals.</summary>
    [Parameter] public string? ThreadId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private readonly ElementReference[] _tabRefs = new ElementReference[Tabs.Length];
    private ElementReference _dialog;
    private Tab _tab = Tab.Agent;
    private Tab? _focusTab;
    private bool _focusDialog = true;
    private bool _loading;
    private bool _asked;
    private AgentIntrospectionResponse? _info;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialog)
        {
            _focusDialog = false;
            await _dialog.FocusAsync();
        }
        else if (_focusTab is { } tab)
        {
            _focusTab = null;
            await _tabRefs[(int)tab].FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _info = ProxyService.IsConnected
                ? await ProxyService.GetIntrospectionAsync(timeout: TimeSpan.FromSeconds(10), threadId: ThreadId) ?? _info
                : null;
        }
        catch
        {
            // Shown as unavailable; the chat itself is unaffected.
        }
        finally
        {
            _asked = true;
            _loading = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
            return;
        }

        // Arrow keys move between tabs (the tablist pattern), as in the activity panel.
        var step = e.Key switch { "ArrowRight" => 1, "ArrowLeft" => Tabs.Length - 1, _ => 0 };
        if (step == 0)
            return;
        _tab = Tabs[(Array.IndexOf(Tabs, _tab) + step) % Tabs.Length];
        _focusTab = _tab;
    }

    private string UnavailableText =>
        !ProxyService.IsConnected ? "Not connected to the message bus."
        : _asked ? "The agent didn't answer. An agent older than this UI doesn't report its configuration; upgrading it adds this."
        : "";

    private static string TabId(Tab tab) => $"rb-info-tab-{tab.ToString().ToLowerInvariant()}";

    private static string TabLabel(Tab tab) => tab switch
    {
        Tab.Agent => "Agent",
        Tab.Models => "Models",
        Tab.Pricing => "Pricing",
        Tab.Usage => "Usage",
        Tab.Mcp => "MCP",
        Tab.Skills => "Skills",
        Tab.Memory => "Memory",
        _ => "Routing",
    };

    private RenderFragment AgentTab => __builder =>
    {
        var version = _info?.AgentVersion ?? AgentVersion;
        <dl class="info-facts">
            <dt>Agent</dt>
            <dd>@(_info?.AgentName ?? AgentName ?? "unknown")</dd>
            <dt>Agent version</dt>
            <dd>@(version is null ? "unknown" : $"v{version}")</dd>
            <dt>UI version</dt>
            <dd>v@(AppVersion)</dd>
            <dt>Message bus</dt>
            <dd>@(ProxyService.IsConnected ? "Connected" : "Disconnected")</dd>
            @if (_info?.StartedAt is { } started)
            {
                <dt>Running since</dt>
                <dd>@AgentInfoFormat.When(started, DisplayZone) <span class="info-muted">(up @AgentInfoFormat.Uptime(DateTimeOffset.UtcNow - started))</span></dd>
            }
            @if (_info?.Models is { } models)
            {
                <dt>Models loaded</dt>
                <dd>@AgentInfoFormat.When(models.LoadedAt, DisplayZone) <span class="info-muted">(a model change needs a restart)</span></dd>
            }
            @if (_info?.Usage is { } usage)
            {
                <dt>Used today</dt>
                <dd>@AgentInfoFormat.Cost(usage.TodayTotals.CostUsd) <span class="info-muted">(@usage.TodayTotals.Requests.ToString("N0") requests, estimated)</span></dd>
            }
        </dl>
        if (_info is null)
        {
            if (_asked)
            {
                <p class="info-unavailable">@UnavailableText</p>
            }
        }
        else
        {
            <p class="info-note">Read from the agent directly: no LLM call, no tokens.</p>
        }
    };

    private static RenderFragment ModelsTab(ModelsIntrospection? models) => __builder =>
    {
        if (models is null)
        {
            <p class="info-unavailable">The agent didn't report its models.</p>
            return;
        }

        if (models.Tiers.Count == 0)
        {
            <p class="info-unavailable">@(models.Note ?? "No LLM tiers are configured.")</p>
        }

        if (models.FixedTier is not null)
        {
            <p class="info-note">Every request is pinned to the <strong>@models.FixedTier</strong> tier (LLM:FixedTier).</p>
        }

        foreach (var tier in models.Tiers)
        {
            <section class="info-tier">
                <h3 class="activity-section-title">
                    @tier.Tier
                    @if (tier.UsesTier is null && tier.Models.Count > 1)
                    {
                        <span class="info-muted"> · fallback chain</span>
                    }
                </h3>
                @if (tier.UsesTier is not null)
                {
                    <p class="info-muted info-tier-uses">No model of its own: uses the @tier.UsesTier model.</p>
                }
                else
                {
                    <ol class="info-models @(tier.Models.Count > 1 ? "chain" : null)">
                        @foreach (var model in tier.Models)
                        {
                            <li class="info-model">
                                <div class="info-model-id"><code>@model.ModelId</code></div>
                                <div class="info-model-tags">
                                    @foreach (var tag in AgentInfoFormat.Tags(model, tier))
                                    {
                                        <span class="info-tag">@tag</span>
                                    }
                                </div>
                                <div class="info-model-price @(model.Price is null ? "unpriced" : null)">@AgentInfoFormat.Price(model.Price)</div>
                            </li>
                        }
                    </ol>
                }
            </section>
        }

        if (models.Tiers.Any(t => t.UsesTier is null && t.Models.Count > 1))
        {
            <p class="info-note">In a fallback chain the first model is used, and each later model only when the ones before it fail.</p>
        }

        <h3 class="activity-section-title">Other models</h3>
        <dl class="info-facts">
            <dt>Embeddings</dt>
            <dd>@(models.Embedding is { } e ? $"{e.ModelId} ({e.Service})" : "None: memory search is keyword-only")</dd>
            <dt>Decision model</dt>
            <dd>
                @if (models.DecisionModel is { } d)
                {
                    <text>@d.Deployment (@d.Service)</text>
                    if (d.DisabledUses.Count > 0)
                    {
                        <span class="info-muted"> · off for @string.Join(", ", d.DisabledUses)</span>
                    }
                }
                else
                {
                    <text>None: checks use their deterministic rules</text>
                }
            </dd>
        </dl>
    };

    private static RenderFragment PricingTab(PricingIntrospection? pricing) => __builder =>
    {
        if (pricing is null)
        {
            <p class="info-unavailable">The agent didn't report its pricing table.</p>
            return;
        }

        <p class="info-note">
            @if (pricing.LoadedFrom is { } path)
            {
                <text>From <code>@path</code>. </text>
            }
            else
            {
                <text>The agent's built-in table (no pricing file loaded). </text>
            }
            USD per million tokens. A model is priced by the first row, longest prefix first, whose prefix its id contains.
        </p>
        <div class="info-table-wrap">
            <table class="info-table">
                <thead>
                    <tr>
                        <th scope="col">Prefix</th>
                        <th scope="col" class="num">Input</th>
                        <th scope="col" class="num">Output</th>
                        <th scope="col" class="num">Cached</th>
                        <th scope="col" class="num">Write 5m</th>
                        <th scope="col" class="num">Write 1h</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in pricing.Rows)
                    {
                        <tr>
                            <th scope="row"><code>@row.Prefix</code></th>
                            <td class="num">@AgentInfoFormat.Money(row.InputPerM)</td>
                            <td class="num">@AgentInfoFormat.Money(row.OutputPerM)</td>
                            <td class="num">@AgentInfoFormat.CacheRate(row.CachedInputPerM, "input")</td>
                            <td class="num">@AgentInfoFormat.CacheRate(row.CacheWrite5mPerM, "1.25×")</td>
                            <td class="num">@AgentInfoFormat.CacheRate(row.CacheWrite1hPerM, "2×")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment UsageTab(UsageIntrospection? usage) => __builder =>
    {
        if (usage is null)
        {
            <p class="info-unavailable">The agent didn't report its usage.</p>
            return;
        }

        <div class="usage-cards">
            @UsageCard("Today", usage.TodayTotals)
            @UsageCard("Last 7 days", usage.Last7Days)
            @UsageCard("Last 30 days", usage.Last30Days)
            @if (usage.Thread is { } thread)
            {
                @UsageCard("This chat", thread.Totals)
            }
        </div>

        if (usage.Last30Days.UnpricedRequests > 0)
        {
            <p class="info-unavailable usage-unpriced">
                @usage.Last30Days.UnpricedRequests.ToString("N0") request(s) in the last 30 days used a model no pricing row
                matches, so they are counted at $0. The Models tab shows which.
            </p>
        }

        if (usage.Days.Count > 0)
        {
            var max = Math.Max(usage.Days.Max(d => d.Totals.CostUsd), 1e-9);
            <h3 class="activity-section-title">By day</h3>
            <div class="info-table-wrap">
                <table class="info-table usage-days">
                    <thead>
                        <tr>
                            <th scope="col">Day</th>
                            <th scope="col" class="num">Requests</th>
                            <th scope="col" class="num narrow-hide">Input</th>
                            <th scope="col" class="num narrow-hide">Output</th>
                            <th scope="col" class="num">Cost</th>
                            <th scope="col" class="usage-bar-col"><span class="visually-hidden">Share of the busiest day</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in usage.Days)
                        {
                            <tr>
                                <th scope="row">@AgentInfoFormat.Day(day.Date)@(day.Date == usage.Today ? " (today)" : "")</th>
                                <td class="num">@day.Totals.Requests.ToString("N0")</td>
                                <td class="num narrow-hide">@AgentInfoFormat.Tokens(day.Totals.InputTokens)</td>
                                <td class="num narrow-hide">@AgentInfoFormat.Tokens(day.Totals.OutputTokens)</td>
                                <td class="num">@AgentInfoFormat.Cost(day.Totals.CostUsd)</td>
                                <td class="usage-bar-col" aria-hidden="true">
                                    <span class="usage-bar"><span style="width: @((int)Math.Round(100 * day.Totals.CostUsd / max))%"></span></span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        if (usage.Models.Count > 0)
        {
            <h3 class="activity-section-title">By model, last 30 days</h3>
            @TotalsTable("Model", usage.Models.Select(m => (m.ModelId, true, m.Totals)))
        }

        if (usage.Kinds.Count > 0)
        {
            <h3 class="activity-section-title">By workload, last 30 days</h3>
            @TotalsTable("Workload", usage.Kinds.Select(k => (AgentInfoFormat.KindLabel(k.Kind), false, k.Totals)))
        }

        if (usage.ScheduledTasks.Count > 0)
        {
            <h3 class="activity-section-title">Scheduled tasks, latest run</h3>
            <div class="info-table-wrap">
                <table class="info-table usage-scheduled">
                    <thead>
                        <tr>
                            <th scope="col">Task</th>
                            <th scope="col" class="narrow-hide">Last run</th>
                            <th scope="col" class="num">Cost</th>
                            <th scope="col" class="num">Usual</th>
                            <th scope="col">Tier</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in usage.ScheduledTasks)
                        {
                            <tr>
                                <th scope="row">
                                    <code>@task.TaskName</code>
                                    @if (task.Gate is { } gate)
                                    {
                                        <span class="info-muted" title="Runs the wisp @gate first and skips its LLM turn when that finds nothing new; @task.GatedSkips recent run(s) skipped"> (gated)</span>
                                    }
                                </th>
                                <td class="narrow-hide">@AgentInfoFormat.When(task.LastRunAt, DisplayZone)</td>
                                <td class="num">
                                    @AgentInfoFormat.Cost(task.LastCostUsd)
                                    @if (task.LastRunFlagged && task.MedianCostUsd is { } median && median > 0)
                                    {
                                        <span class="info-alert" title="Far above this task's recent runs"> (@((task.LastCostUsd / median).ToString("0.#"))×)</span>
                                    }
                                </td>
                                <td class="num">
                                    @if (task.LastOptimizedAt is { } optimizedAt && task.MedianBeforeOptimizationUsd is { } before)
                                    {
                                        <span title="Optimized @AgentInfoFormat.When(optimizedAt, DisplayZone): @task.OptimizationNote">
                                            @AgentInfoFormat.Cost(before) → @(task.MedianSinceOptimizationUsd is { } after ? AgentInfoFormat.Cost(after) : "…")
                                        </span>
                                    }
                                    else
                                    {
                                        @(task.MedianCostUsd is { } m ? AgentInfoFormat.Cost(m) : "—")
                                    }
                                </td>
                                <td>
                                    @(task.LastRunTier ?? "—")
                                    @if (task.MaxTier is { } maxTier)
                                    {
                                        <span class="info-muted" title="@task.MaxTierReason"> (capped at @maxTier)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <p class="info-note">
            Estimated from the agent's pricing table, counting every request it sends: conversations
            (with the subagents and workers they start), scheduled tasks and its own background work.
            Days are in @usage.TimeZone@(usage.Since is { } since ? $"; counted since {AgentInfoFormat.When(since, DisplayZone)}" : "").
        </p>
    };

    private static RenderFragment UsageCard(string label, UsageTotalsIntrospection totals) => __builder =>
    {
        <div class="usage-card">
            <div class="usage-card-label">@label</div>
            <div class="usage-card-cost">@AgentInfoFormat.Cost(totals.CostUsd)</div>
            <div class="usage-card-detail">
                @totals.Requests.ToString("N0") requests · @AgentInfoFormat.Tokens(totals.InputTokens) in · @AgentInfoFormat.Tokens(totals.OutputTokens) out
                @if (AgentInfoFormat.CacheShare(totals) is { } share)
                {
                    <span> · @share</span>
                }
            </div>
        </div>
    };

    private static RenderFragment TotalsTable(string header, IEnumerable<(string Label, bool Code, UsageTotalsIntrospection Totals)> rows) => __builder =>
    {
        <div class="info-table-wrap">
            <table class="info-table">
                <thead>
                    <tr>
                        <th scope="col">@header</th>
                        <th scope="col" class="num">Requests</th>
                        <th scope="col" class="num narrow-hide">Input</th>
                        <th scope="col" class="num narrow-hide">Cached</th>
                        <th scope="col" class="num narrow-hide">Output</th>
                        <th scope="col" class="num">Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (label, code, t) in rows)
                    {
                        <tr>
                            <th scope="row">
                                @if (code)
                                {
                                    <code>@label</code>
                                }
                                else
                                {
                                    @label
                                }
                            </th>
                            <td class="num">@t.Requests.ToString("N0")</td>
                            <td class="num narrow-hide">@AgentInfoFormat.Tokens(t.InputTokens)</td>
                            <td class="num narrow-hide">@AgentInfoFormat.Tokens(t.CachedInputTokens)</td>
                            <td class="num narrow-hide">@AgentInfoFormat.Tokens(t.OutputTokens)</td>
                            <td class="num">@AgentInfoFormat.Cost(t.CostUsd)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment McpTab(McpIntrospection? mcp) => __builder =>
    {
        if (mcp is null)
        {
            <p class="info-unavailable">The agent didn't report its MCP servers.</p>
            return;
        }

        if (mcp.Servers.Count == 0)
        {
            <p class="info-unavailable">No MCP servers are configured.</p>
            return;
        }

        <p class="info-note info-lead">
            @mcp.Servers.Count(s => s.State == "connected") of @mcp.Servers.Count servers connected,
            @mcp.Servers.Sum(s => s.ToolCount).ToString("N0") tools in all.
        </p>
        <ul class="info-list">
            @foreach (var s in mcp.Servers)
            {
                <li class="info-model">
                    <div class="info-row-head">
                        <code class="info-row-name">@s.Name</code>
                        <span class="info-state @AgentInfoFormat.StateTone(s.State)"><span class="info-state-dot" aria-hidden="true"></span>@AgentInfoFormat.McpState(s.State)</span>
                    </div>
                    <div class="info-model-tags">
                        @if (s.DisplayName is { } display)
                        {
                            <span class="info-tag">@display</span>
                        }
                        <span class="info-tag">@(s.Host ?? s.Transport)</span>
                        @if (s.UsesOAuth)
                        {
                            <span class="info-tag">OAuth sign-in</span>
                        }
                        @if (s.Version is { } version)
                        {
                            <span class="info-tag">v@(version)</span>
                        }
                    </div>
                    @if (s.State == "connected")
                    {
                        <div class="info-model-price">@AgentInfoFormat.McpCounts(s)</div>
                    }
                    else if (s.LastError is { } error)
                    {
                        <div class="info-model-price unpriced">@error@(s.LastErrorAt is { } at ? $" ({AgentInfoFormat.When(at, DisplayZone)})" : "")</div>
                    }
                </li>
            }
        </ul>
        if (mcp.Servers.Any(s => s.State == "sign-in required"))
        {
            <p class="info-note">A server waiting for sign-in is signed in from the banner above the chat.</p>
        }
    };

    private RenderFragment SkillsTab(SkillsIntrospection? skills) => __builder =>
    {
        if (skills is null)
        {
            <p class="info-unavailable">The agent didn't report its skills.</p>
            return;
        }

        <div class="usage-cards">
            @CountCard("Skills", skills.Count)
            @CountCard("Learned", skills.Learned)
            @CountCard("Starter", skills.Starter)
            @CountCard("From MCP", skills.FromMcp)
        </div>
        if (skills.Skills.Count == 0)
        {
            return;
        }

        <div class="info-table-wrap">
            <table class="info-table">
                <thead>
                    <tr>
                        <th scope="col">Skill</th>
                        <th scope="col">Source</th>
                        <th scope="col">Last used</th>
                        <th scope="col" class="narrow-hide">Summary</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in skills.Skills.OrderByDescending(s => s.LastUsedAt ?? DateTimeOffset.MinValue).ThenBy(s => s.Name, StringComparer.Ordinal))
                    {
                        <tr>
                            <th scope="row"><code>@s.Name</code></th>
                            <td>@s.Source</td>
                            <td class="nowrap">@(s.LastUsedAt is { } used ? AgentInfoFormat.Ago(DateTimeOffset.UtcNow - used) : "never")</td>
                            <td class="narrow-hide info-muted wrap">@s.Summary</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    };

    private RenderFragment MemoryTab(MemoryIntrospection? memory) => __builder =>
    {
        if (memory is null)
        {
            <p class="info-unavailable">The agent didn't report its memory health.</p>
            return;
        }

        if (memory.ConsolidationPaused)
        {
            <p class="info-unavailable usage-unpriced info-alert">
                <strong>Memory consolidation is paused.</strong>
                @(memory.ConsolidationPausedReason is { } reason ? $" {reason}." : "")
                Dreams won't merge or archive memories until it's resumed (ask the agent to resume memory consolidation).
            </p>
        }

        if (memory.AuditedAt is not { } audited)
        {
            <p class="info-unavailable">No memory audit has run yet. The agent audits its memory on a schedule.</p>
            return;
        }

        <div class="info-row-head info-lead">
            <span class="info-state @AgentInfoFormat.StateTone(memory.Status ?? "")"><span class="info-state-dot" aria-hidden="true"></span>@AgentInfoFormat.AuditStatus(memory.Status)</span>
            <span class="info-muted">audited @AgentInfoFormat.When(audited, DisplayZone)</span>
        </div>
        <div class="usage-cards">
            @CountCard("Live memories", memory.Live)
            @CountCard("Archived", memory.Archived)
            @CountCard("Near-duplicate pairs", memory.NearDuplicatePairs)
            @CountCard($"Purge due ({memory.PurgeDueWithinDays}d)", memory.PurgeDueCount)
        </div>
        <dl class="info-facts">
            <dt>Since the audit before</dt>
            <dd>
                +@memory.CreatedSinceLast created, @memory.ArchivedSinceLast archived, @memory.HardDeletedSinceLast deleted
                @if (memory.NetGrowthPerDay is { } growth)
                {
                    <span class="info-muted"> (@AgentInfoFormat.Growth(growth) per day)</span>
                }
            </dd>
            @if (memory.EvalSoundRate is { } rate)
            {
                <dt>Judged sound</dt>
                <dd>@AgentInfoFormat.Percent(rate) of sampled memories @(memory.EvaluatedAt is { } e ? $"(evaluated {AgentInfoFormat.When(e, DisplayZone)})" : "")</dd>
            }
            @if (!memory.ConsolidationPaused && memory.ConsolidationLastRunAt is { } last)
            {
                <dt>Consolidation</dt>
                <dd>last ran @AgentInfoFormat.When(last, DisplayZone)</dd>
            }
        </dl>
        if (memory.Findings.Count > 0)
        {
            <h3 class="activity-section-title">Findings</h3>
            <ul class="info-findings">
                @foreach (var f in memory.Findings)
                {
                    <li><strong>@f.Name</strong>: @f.Message</li>
                }
            </ul>
        }
    };

    private RenderFragment RoutingTab(RoutingIntrospection? routing) => __builder =>
    {
        if (routing is null)
        {
            <p class="info-unavailable">The agent didn't report its routing.</p>
            return;
        }

        <p class="info-note info-lead">
            Last @routing.WindowDays days: @routing.Total.ToString("N0") routed requests
            (@routing.UserMessages.ToString("N0") user messages, @routing.Subagents.ToString("N0") subagent runs).
        </p>
        if (routing.Total == 0)
        {
            return;
        }

        <div class="info-table-wrap">
            <table class="info-table">
                <thead>
                    <tr>
                        <th scope="col">Tier</th>
                        <th scope="col" class="num">Requests</th>
                        <th scope="col" class="share-col">Share</th>
                        <th scope="col" class="num">Latency</th>
                        <th scope="col" class="num narrow-hide">Input</th>
                        <th scope="col" class="num narrow-hide">Output</th>
                        <th scope="col" class="num narrow-hide">Tools</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in routing.Tiers)
                    {
                        <tr>
                            <th scope="row">@t.Tier</th>
                            <td class="num">@t.Count.ToString("N0")</td>
                            <td class="share-col">
                                <span class="usage-share">
                                    <span class="usage-bar" aria-hidden="true"><span style="width: @((int)Math.Round(t.Pct))%"></span></span>
                                    <span class="num">@AgentInfoFormat.Percent(t.Pct / 100)</span>
                                </span>
                            </td>
                            <td class="num">@(t.AvgLatencyMs is { } ms ? AgentInfoFormat.Seconds(ms) : "–")</td>
                            <td class="num narrow-hide">@(t.AvgInputTokens is { } i ? AgentInfoFormat.Tokens(i) : "–")</td>
                            <td class="num narrow-hide">@(t.AvgOutputTokens is { } o ? AgentInfoFormat.Tokens(o) : "–")</td>
                            <td class="num narrow-hide">@t.AvgToolCalls.ToString("0.0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="info-note">
            Averages per request. @routing.Fallbacks.ToString("N0") request(s) (@AgentInfoFormat.Percent(routing.FallbackPct / 100))
            were answered by a fallback model because the tier's first model failed.
        </p>
    };

    private static RenderFragment CountCard(string label, int value) => __builder =>
    {
        <div class="usage-card">
            <div class="usage-card-label">@label</div>
            <div class="usage-card-cost">@value.ToString("N0")</div>
        </div>
    };
}
