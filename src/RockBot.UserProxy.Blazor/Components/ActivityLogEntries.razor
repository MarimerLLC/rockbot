@* An activity log's entries: progress lines, and tool calls as cards updated in place as each
   call finishes (#795). Shared by the transcript's activity-log bubbles (Detailed view) and the
   activity panel's cards, so the two always show a log the same way. *@

<div class="activity-log-entries">
    @foreach (var entry in Entries)
    {
        var time = TimeZoneInfo.ConvertTimeFromUtc(entry.Timestamp, DisplayZone).ToString("HH:mm:ss");
        @if (entry.ToolCall is { } call)
        {
            @* The bubble around a log toggles on click; opening a call's card mustn't toggle it. *@
            <div class="activity-log-entry" @onclick:stopPropagation="true">
                <span class="entry-time">@time</span>
                <details class="tool-call-card tool-call-@call.Phase">
                    <summary>
                        <span class="tool-call-status" aria-hidden="true">@Marker(call.Phase)</span>
                        <span class="visually-hidden">@PhaseText(call.Phase): </span>
                        <span class="tool-call-name">@call.ToolCallName</span>
                        @if (call.DurationMs is { } ms)
                        {
                            <span class="tool-call-duration">@FormatDuration(ms)</span>
                        }
                    </summary>
                    @if (!string.IsNullOrEmpty(call.ArgsSummary))
                    {
                        <div class="tool-call-field"><span class="tool-call-label">Arguments</span> @call.ArgsSummary</div>
                    }
                    @if (!string.IsNullOrEmpty(call.Result))
                    {
                        <div class="tool-call-field"><span class="tool-call-label">Result</span> @call.Result</div>
                    }
                    @if (!string.IsNullOrEmpty(call.Error))
                    {
                        <div class="tool-call-field tool-call-error"><span class="tool-call-label">Error</span> @call.Error</div>
                    }
                </details>
            </div>
        }
        else
        {
            <div class="activity-log-entry">
                <span class="entry-time">@time</span>
                <span class="entry-content">@entry.Content</span>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ActivityLogEntry> Entries { get; set; } = [];

    [Parameter] public TimeZoneInfo DisplayZone { get; set; } = TimeZoneInfo.Utc;

    private static string Marker(string phase) => phase switch
    {
        ToolCallPhase.Finished => "✓",
        ToolCallPhase.Failed => "✗",
        _ => "…",
    };

    private static string PhaseText(string phase) => phase switch
    {
        ToolCallPhase.Finished => "finished",
        ToolCallPhase.Failed => "failed",
        _ => "running",
    };

    internal static string FormatDuration(long ms) =>
        ms < 1000 ? $"{ms} ms" : $"{ms / 1000.0:0.0} s";
}
