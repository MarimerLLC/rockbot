@using Microsoft.AspNetCore.Components.Authorization
@using RockBot.UserProxy.Blazor.Auth
@inject NavigationManager Navigation

@* Rendered by AuthorizeRouteView when the page's [Authorize] is not satisfied. Two distinct cases,
   and conflating them is what makes this kind of gate confusing to be on the wrong side of:
     - not signed in at all  → /login, carrying where they were headed
     - signed in, but not on the allowlist → /access-denied, which names the account *@

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var isAuthenticated = false;
        if (AuthenticationStateTask is not null)
        {
            var state = await AuthenticationStateTask;
            isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        }

        if (isAuthenticated)
        {
            Navigation.NavigateTo("/access-denied", forceLoad: false, replace: true);
            return;
        }

        var returnUrl = LocalReturnUrl.Sanitize(Navigation.ToBaseRelativePath(Navigation.Uri) is var relative && relative.Length > 0
            ? "/" + relative
            : "/");

        Navigation.NavigateTo(
            $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: false,
            replace: true);
    }
}
