@page "/"
@using RockBot.UserProxy.Blazor.Services
@using Microsoft.JSInterop
@inject UserProxyService ProxyService
@inject ChatStateService ChatState
@inject IJSRuntime JSRuntime
@inject WorkIqAuthUiService WorkIqAuth
@implements IDisposable

<PageTitle>@(ChatState.AgentName ?? "RockBot") Chat</PageTitle>

<div class="chat-container d-flex flex-column">
    <div class="chat-header bg-primary text-white p-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-baseline gap-2">
            <h1 class="h4 mb-0">@(ChatState.AgentName ?? "RockBot") Chat</h1>
            <span class="small opacity-75">v@(UiVersion)</span>
            @if (ChatState.AgentVersion is not null)
            {
                <span class="small opacity-75">| Agent v@(ChatState.AgentVersion)</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (ChatState.IsProcessing)
            {
                <span class="status-indicator agent-busy"
                      title="@(ChatState.CurrentThinkingMessage ?? "Agent is processing...")">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                </span>
            }
            @{
                var statusIndicators = ChatState.GetActiveStatusIndicators();
            }
            @foreach (var sub in statusIndicators.Where(i => i.Category == MessageCategory.SubagentActivity))
            {
                var name = sub.AgentName?.StartsWith("subagent-") == true
                    ? sub.AgentName["subagent-".Length..]
                    : sub.AgentName ?? "subagent";
                <span class="status-indicator subagent-indicator"
                      title="@($"{name}: {sub.LatestContent}")">
                    🤖
                </span>
            }
            @foreach (var task in statusIndicators.Where(i => i.Category == MessageCategory.ScheduledSystem))
            {
                <span class="status-indicator task-indicator"
                      title="@($"Background task: {task.LatestContent}")">
                    ⏱️
                </span>
            }
            @foreach (var a2a in statusIndicators.Where(i => i.Category == MessageCategory.A2AActivity))
            {
                <span class="status-indicator a2a-indicator"
                      title="@($"Inbound A2A: {a2a.LatestContent}")">
                    🔗
                </span>
            }
            <button class="btn btn-sm btn-outline-light" @onclick="ToggleWorkIqModal" title="Connect Microsoft 365">
                M365
            </button>
            <button class="btn btn-sm btn-outline-light" @onclick="ToggleSavedModal" title="Saved responses">
                📋
            </button>
            <button class="btn btn-sm btn-outline-light" @onclick="ToggleDarkMode" title="Toggle dark/light mode">
                @(IsDarkMode ? "☀️" : "🌙")
            </button>
            <span class="connection-dot @(ProxyService.IsConnected ? "connected" : "disconnected")"
                  title="@(ProxyService.IsConnected ? "Connected to message bus" : "Disconnected from message bus")"></span>
        </div>
    </div>

    <WorkIqReconnectBanner OnReconnectClicked="OpenWorkIqModalFromBanner" />

    <div class="chat-messages flex-grow-1 overflow-auto p-3" @ref="messagesContainer">
        @foreach (var message in ChatState.Messages)
        {
            @if (message.IsActivityLog)
            {
                <!-- Activity log bubble: collapsed one-liner with spinner, expandable to full log -->
                <div class="message-wrapper mb-3 agent-message">
                    <div class="message-bubble activity-log-bubble p-2 rounded category-@message.Category.ToString().ToLowerInvariant() @(message.IsExpanded ? "expanded" : "collapsed")"
                         @onclick="() => ChatState.ToggleExpanded(message.MessageId)">
                        <div class="activity-log-header">
                            <span class="chevron-indicator @(message.IsExpanded ? "open" : "")">&#9654;</span>
                            @if (ChatState.IsActiveActivityLog(message.MessageId))
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            }
                            @if (message.Category != MessageCategory.PrimaryProgress)
                            {
                                <span class="category-badge">@GetCategoryLabel(message.Category)</span>
                            }
                            @if (!string.IsNullOrEmpty(message.AgentName))
                            {
                                <span class="collapsible-agent-name">@message.AgentName</span>
                            }
                            <span class="activity-log-summary">@TruncateText(message.Content, 80)</span>
                            <span class="activity-log-count">(@(message.ActivityLogEntries.Count))</span>
                        </div>
                        @if (message.IsExpanded)
                        {
                            var entries = message.ActivityLogEntries.ToList();
                            <div class="activity-log-entries">
                                @foreach (var entry in entries)
                                {
                                    <div class="activity-log-entry">
                                        <span class="entry-time">@TimeZoneInfo.ConvertTimeFromUtc(entry.Timestamp, _displayZone).ToString("HH:mm:ss")</span>
                                        <span class="entry-content">@entry.Content</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else if (IsCollapsibleCategory(message.Category))
            {
                <!-- Collapsible bubble: compact header when collapsed, full content when expanded -->
                <div class="message-wrapper mb-3 agent-message">
                    <div class="message-bubble collapsible-bubble p-3 rounded category-@message.Category.ToString().ToLowerInvariant() @(message.IsExpanded ? "expanded" : "collapsed")">
                        <div class="collapsible-header" @onclick="() => ChatState.ToggleExpanded(message.MessageId)" @onclick:stopPropagation="true">
                            <span class="chevron-indicator @(message.IsExpanded ? "open" : "")">&#9654;</span>
                            <span class="category-badge">@GetCategoryLabel(message.Category)</span>
                            @if (!string.IsNullOrEmpty(message.AgentName))
                            {
                                <span class="collapsible-agent-name">@message.AgentName</span>
                            }
                            @if (!message.IsExpanded)
                            {
                                <span class="collapsible-preview">@TruncateText(message.Content, 80)</span>
                            }
                        </div>
                        @if (message.IsExpanded)
                        {
                            <div class="message-content mt-2">
                                @((MarkupString)SafeMarkdownRenderer.RenderSafe(message.Content))
                            </div>
                            <AttachmentList Attachments="message.Attachments" />
                            <div class="message-time">
                                @TimeZoneInfo.ConvertTimeFromUtc(message.Timestamp, _displayZone).ToString("HH:mm:ss")
                            </div>
                        }
                    </div>
                </div>
            }
            else if (message.Category == MessageCategory.SavedReference)
            {
                <!-- Saved reference bubble: distinct accent styling with dismiss button -->
                <div class="message-wrapper mb-3 agent-message">
                    <div class="message-bubble saved-reference-bubble p-3 rounded">
                        <div class="saved-badge-header">
                            <span class="category-badge saved-badge">Saved</span>
                            <span class="saved-label">@message.SavedResponseLabel</span>
                            <button class="btn-feedback" title="Dismiss" @onclick="() => DismissSavedReference(message)">✕</button>
                        </div>
                        @if (!string.IsNullOrEmpty(message.AgentName))
                        {
                            <div class="fw-bold small mb-2">@message.AgentName</div>
                        }
                        <div class="message-content mt-2">
                            @((MarkupString)SafeMarkdownRenderer.RenderSafe(message.Content))
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Standard expanded bubble: user input, primary final, scheduled user, error -->
                <div class="message-wrapper mb-3 @(message.IsFromUser ? "user-message" : "agent-message")">
                    <div class="message-bubble p-3 rounded @(message.IsError ? "bg-danger text-white" : (message.IsFromUser ? "bg-primary text-white" : "")) @(message.IsInterim ? "interim-message" : "")">
                        @if (!message.IsFromUser && !message.IsError && !string.IsNullOrEmpty(message.AgentName))
                        {
                            <div class="@(message.IsInterim ? "fst-italic" : "fw-bold") small mb-2">@message.AgentName</div>
                        }
                        <div class="message-content">
                            @((MarkupString)SafeMarkdownRenderer.RenderSafe(message.Content))
                        </div>
                        <AttachmentList Attachments="message.Attachments" />
                        <div class="message-time">
                            @TimeZoneInfo.ConvertTimeFromUtc(message.Timestamp, _displayZone).ToString("HH:mm:ss")
                        </div>
                        @if (!message.IsFromUser && !message.IsError)
                        {
                            <div class="feedback-bar">
                                <button class="btn-feedback @(message.Feedback == FeedbackState.ThumbsUp ? "active" : "")"
                                        title="This was helpful"
                                        disabled="@(message.Feedback != FeedbackState.None)"
                                        @onclick="() => SendFeedback(message, isPositive: true)">
                                    👍
                                </button>
                                <button class="btn-feedback @(message.Feedback == FeedbackState.ThumbsDown ? "active" : "")"
                                        title="This wasn't helpful — please try again"
                                        disabled="@(message.Feedback != FeedbackState.None)"
                                        @onclick="() => SendFeedback(message, isPositive: false)">
                                    👎
                                </button>
                                @if (message.Category == MessageCategory.PrimaryFinal)
                                {
                                    <button class="btn-feedback" title="Save this response"
                                            @onclick="() => StartSaveFlow(message)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M11 2H9v3h2z"/>
                                            <path d="M1.5 0h11.586a1.5 1.5 0 0 1 1.06.44l1.415 1.414A1.5 1.5 0 0 1 16 2.914V14.5a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 14.5v-13A1.5 1.5 0 0 1 1.5 0M1 1.5v13a.5.5 0 0 0 .5.5H2v-4.5A1.5 1.5 0 0 1 3.5 9h9a1.5 1.5 0 0 1 1.5 1.5V15h.5a.5.5 0 0 0 .5-.5V2.914a.5.5 0 0 0-.146-.353l-1.415-1.415A.5.5 0 0 0 13.086 1H13v4.5A1.5 1.5 0 0 1 11.5 7h-7A1.5 1.5 0 0 1 3 5.5V1H1.5a.5.5 0 0 0-.5.5m3 0V5a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5V1zM3 15h10v-4.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5z"/>
                                        </svg>
                                    </button>
                                }
                            </div>
                            @if (_savingMessageId == message.MessageId)
                            {
                                <div class="save-label-input d-flex gap-1 mt-1">
                                    <input type="text" class="form-control form-control-sm" placeholder="Label this response..."
                                           @bind="_saveLabel" @bind:event="oninput"
                                           @onkeydown="HandleSaveLabelKeyDown" />
                                    <button class="btn btn-sm btn-success" @onclick="() => ConfirmSave(message)"
                                            disabled="@string.IsNullOrWhiteSpace(_saveLabel)">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelSave">Cancel</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }

        @{
            var hasActiveActivityLog = ChatState.Messages.Any(m => m.IsActivityLog && !m.IsExpanded);
        }
        @if ((ChatState.IsProcessing && !hasActiveActivityLog) || (!ChatState.IsProcessing && !string.IsNullOrEmpty(ChatState.CurrentThinkingMessage)))
        {
            <div class="message-wrapper mb-3 agent-message">
                <div class="message-bubble p-3 rounded">
                    <div class="thinking-indicator">
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        @if (!string.IsNullOrEmpty(ChatState.CurrentThinkingMessage))
                        {
                            <span>@ChatState.CurrentThinkingMessage</span>
                        }
                        else
                        {
                            <span>Thinking...</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (_showWorkIqModal)
    {
        <div class="modal-overlay" @onclick="ToggleWorkIqModal">
            <div class="saved-modal" @onclick:stopPropagation="true">
                <div class="saved-view-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Connect Microsoft 365</h5>
                    <button class="btn btn-sm btn-link" @onclick="ToggleWorkIqModal" title="Close">✕</button>
                </div>
                <div class="p-3">
                    <WorkIqConnect />
                </div>
            </div>
        </div>
    }

    @if (_showSavedModal)
    {
        <div class="modal-overlay" @onclick="ToggleSavedModal">
            <div class="saved-modal" @onclick:stopPropagation="true">
                @if (_viewingItem is not null)
                {
                    <div class="saved-view-header">
                        <h5>@_viewingItem.Label</h5>
                        <small class="saved-item-meta">@_viewingItem.AgentName — @TimeZoneInfo.ConvertTime(_viewingItem.SavedAt, _displayZone).ToString("MMM d, yyyy h:mm tt")</small>
                    </div>
                    <div class="saved-view-content">
                        @((MarkupString)SafeMarkdownRenderer.RenderSafe(_viewingItem.Content))
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-secondary" @onclick="BackToSavedList">Back</button>
                        <button class="btn btn-sm btn-primary" @onclick="() => InsertViewedItem()">Insert into chat</button>
                    </div>
                }
                else
                {
                    <h5>Saved Responses</h5>
                    @if (_savedItems is null)
                    {
                        <p>Loading...</p>
                    }
                    else if (_savedItems.Count == 0)
                    {
                        <p class="text-muted">No saved responses yet.</p>
                    }
                    else
                    {
                        @foreach (var item in _savedItems)
                        {
                            <div class="saved-item d-flex justify-content-between align-items-center p-2 mb-1 rounded">
                                <div class="saved-item-info" @onclick="() => LoadSavedItem(item.Id)" style="cursor:pointer;" title="Insert into chat">
                                    <strong>@item.Label</strong>
                                    <small class="saved-item-meta d-block">@item.AgentName — @TimeZoneInfo.ConvertTime(item.SavedAt, _displayZone).ToString("MMM d, yyyy h:mm tt")</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewSavedItem(item.Id)" title="View">👁️</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSavedItem(item.Id)" title="Delete">🗑️</button>
                                </div>
                            </div>
                        }
                    }
                    <button class="btn btn-sm btn-secondary mt-2" @onclick="ToggleSavedModal">Close</button>
                }
            </div>
        </div>
    }

    <div class="chat-input bg-light p-3 border-top">
        <form @onsubmit="SendMessage" @onsubmit:preventDefault="true" class="d-flex gap-2">
            <textarea
                class="form-control"
                placeholder="Type your message..."
                @bind="currentMessage"
                @bind:event="oninput"
                @ref="messageInput"
                @onkeydown="HandleKeyDown"
                disabled="@ChatState.IsProcessing"
                rows="1"
                aria-label="Message input"></textarea>
            <button
                type="submit"
                class="btn btn-primary"
                disabled="@(string.IsNullOrWhiteSpace(currentMessage) || ChatState.IsProcessing || !ProxyService.IsConnected)"
                aria-label="Send message">
                Send
            </button>
            @if (ChatState.IsProcessing)
            {
                <button
                    type="button"
                    class="btn btn-outline-danger btn-sm"
                    @onclick="CancelSession"
                    aria-label="Cancel current work">
                    Cancel
                </button>
            }
        </form>
    </div>
</div>

@code {
    private const string SessionId = "blazor-session";
    private const string UserId = "blazor-user";

    private static readonly string UiVersion = AssemblyVersion.Current;

    private string currentMessage = string.Empty;
    private ElementReference messagesContainer;
    private ElementReference messageInput;
    private bool IsDarkMode = false;
    private TimeZoneInfo _displayZone = TimeZoneInfo.Utc;
    private Action? _stateChangedHandler;
    private Action? _connectionChangedHandler;
    private int _renderedMessageCount = 0;

    // Save flow state
    private string? _savingMessageId;
    private string _saveLabel = string.Empty;
    private bool _showSavedModal;
    private bool _showWorkIqModal;
    private IReadOnlyList<SavedResponseSummary>? _savedItems;
    private GetSavedResponseResponse? _viewingItem;

    private string? _lastRenderedAgentName;

    protected override void OnInitialized()
    {
        _stateChangedHandler = () => InvokeAsync(StateHasChanged);
        ChatState.OnStateChanged += _stateChangedHandler;

        _connectionChangedHandler = () => InvokeAsync(StateHasChanged);
        ProxyService.OnConnectionChanged += _connectionChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // PageTitle doesn't reliably re-render on state changes, so sync via JS
        var currentName = ChatState.AgentName ?? "RockBot";
        if (_lastRenderedAgentName != currentName)
        {
            _lastRenderedAgentName = currentName;
            await JSRuntime.InvokeVoidAsync("chatHelpers.setPageTitle", $"{currentName} Chat");
        }

        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("chatHelpers.preventEnterNewline", messageInput);
            await JSRuntime.InvokeVoidAsync("chatHelpers.initInputHistory", messageInput);
            await JSRuntime.InvokeVoidAsync("chatHelpers.focusInputOnWindowFocus", messageInput);

            var tzId = await JSRuntime.InvokeAsync<string>("chatHelpers.getBrowserTimezone");
            try { _displayZone = TimeZoneInfo.FindSystemTimeZoneById(tzId); }
            catch { _displayZone = TimeZoneInfo.Utc; }

            // Check for system dark mode preference
            IsDarkMode = await JSRuntime.InvokeAsync<bool>("eval",
                "window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches");
            await ApplyDarkMode();

            // Load history after the real SignalR circuit is established.
            // This runs only on first render (never during static prerendering),
            // which avoids a 10-second blank-page wait and prevents duplicate
            // messages when the singleton ChatStateService outlives the component.
            try
            {
                var info = await ProxyService.GetAgentInfoAsync(timeout: TimeSpan.FromSeconds(5));
                if (info is not null)
                    ChatState.SetAgentInfo(info.AgentName, info.AgentVersion);
            }
            catch { /* non-fatal — header falls back to defaults */ }

            try
            {
                var history = await ProxyService.GetHistoryAsync(SessionId, timeout: TimeSpan.FromSeconds(10));
                if (history is not null && history.Turns.Count > 0)
                    ChatState.LoadHistory(history.Turns, SessionId);
            }
            catch (Exception ex)
            {
                ChatState.AddError($"Could not load conversation history: {ex.Message}");
            }

            // Reconcile active status indicators against the agent's ground truth.
            // This clears stale subagent spinners/header badges that persist in the
            // singleton ChatStateService across page reloads, and seeds indicators
            // for subagents that started before this UI connected.
            try
            {
                var status = await ProxyService.GetActiveStatusAsync(timeout: TimeSpan.FromSeconds(5));
                if (status is not null)
                    ChatState.ReconcileActiveStatus(status);
            }
            catch { /* non-fatal — stale indicators clear on next user message */ }
        }

        // Only scroll when a new message has been added — not on every re-render
        // (e.g. theme toggles should not move the scroll position).
        // Scroll to the TOP of the new message so long responses are read top-to-bottom.
        var currentCount = ChatState.Messages.Count;
        if (currentCount > _renderedMessageCount)
        {
            _renderedMessageCount = currentCount;
            await JSRuntime.InvokeVoidAsync("eval",
                "var msgs = document.querySelectorAll('.message-wrapper'); if (msgs.length) msgs[msgs.length - 1].scrollIntoView({ behavior: 'smooth', block: 'start' });");
        }
    }

    private async Task CancelSession()
    {
        try
        {
            await ProxyService.CancelSessionAsync(SessionId);
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Could not cancel: {ex.Message}");
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage))
            return;

        var messageContent = currentMessage.Trim();
        currentMessage = string.Empty;
        await JSRuntime.InvokeVoidAsync("chatHelpers.addToHistory", messageInput, messageContent);

        // Handle /clear command — pure plumbing, no LLM involved
        if (messageContent.Equals("/clear", StringComparison.OrdinalIgnoreCase))
        {
            ChatState.ClearMessages();
            try
            {
                await ProxyService.ClearContextAsync(SessionId);
            }
            catch (Exception ex)
            {
                ChatState.AddError($"Could not clear agent context: {ex.Message}");
            }
            return;
        }

        ChatState.AddUserMessage(messageContent, UserId, SessionId);
        ChatState.SetProcessing(true);

        // If a saved reference is active, prepend it as context for the agent
        var savedRef = ChatState.GetActiveSavedReference();
        string effectiveContent;
        if (savedRef is not null)
        {
            effectiveContent =
                $"[The user is referencing a previously saved agent response labeled \"{savedRef.SavedResponseLabel}\":]\n\n" +
                $"---\n{savedRef.Content}\n---\n\n" +
                messageContent;
        }
        else
        {
            effectiveContent = messageContent;
        }

        var message = new UserMessage
        {
            Content = effectiveContent,
            SessionId = SessionId,
            UserId = UserId,
            ClientCapabilities = ClientCapabilityPresets.Blazor,
            ChannelName = "blazor"
        };

        var progressTracker = new Progress<AgentReply>(reply =>
        {
            ChatState.AppendActivityLogEntry(reply.Content);
        });

        try
        {
            var reply = await ProxyService.SendAsync(message, progress: progressTracker);

            // Clear any background status from the thinking indicator before showing result
            ChatState.SetThinkingMessage(null);

            if (reply is null)
            {
                ChatState.AddError("No reply received (timeout)");
            }
            else
            {
                ChatState.AddAgentReply(reply);
            }
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Error: {ex.Message}");
        }
        finally
        {
            ChatState.SetProcessing(false);
            await messageInput.FocusAsync();
        }
    }

    private async Task SendFeedback(ChatMessage message, bool isPositive)
    {
        ChatState.RecordFeedback(message.MessageId, isPositive);

        var feedback = new UserFeedback
        {
            SessionId = message.SessionId ?? SessionId,
            MessageId = message.MessageId,
            IsPositive = isPositive,
            AgentName = message.AgentName
        };

        try
        {
            await ProxyService.SendFeedbackAsync(feedback);
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Could not send feedback: {ex.Message}");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey)
            await SendMessage();
    }

    private static bool IsCollapsibleCategory(MessageCategory category)
        => category is MessageCategory.SubagentActivity
            or MessageCategory.A2AActivity
            or MessageCategory.ScheduledSystem;

    private static string GetCategoryLabel(MessageCategory category) => category switch
    {
        MessageCategory.SubagentActivity => "Subagent",
        MessageCategory.A2AActivity => "Inbound A2A",
        MessageCategory.ScheduledSystem => "Background Task",
        _ => "Agent"
    };

    private static string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        // Take first line, truncate if needed
        var firstLine = text.Split('\n', 2)[0];
        return firstLine.Length <= maxLength ? firstLine : firstLine[..(maxLength - 1)] + "\u2026";
    }

    private async Task ToggleDarkMode()
    {
        IsDarkMode = !IsDarkMode;
        await ApplyDarkMode();
    }

    private async Task ApplyDarkMode()
    {
        await JSRuntime.InvokeVoidAsync("eval",
            IsDarkMode
                ? "document.body.classList.add('dark-mode')"
                : "document.body.classList.remove('dark-mode')");
        StateHasChanged();
    }

    // ── Save flow ──────────────────────────────────────────────────────────

    private void StartSaveFlow(ChatMessage message)
    {
        _savingMessageId = message.MessageId;
        _saveLabel = string.Empty;
    }

    private void CancelSave()
    {
        _savingMessageId = null;
        _saveLabel = string.Empty;
    }

    private async Task ConfirmSave(ChatMessage message)
    {
        if (string.IsNullOrWhiteSpace(_saveLabel)) return;

        var request = new SaveResponseRequest
        {
            Label = _saveLabel.Trim(),
            Content = message.Content,
            AgentName = message.AgentName ?? "unknown",
            SessionId = message.SessionId ?? SessionId
        };

        try
        {
            await ProxyService.SaveResponseAsync(request);
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Could not save response: {ex.Message}");
        }

        _savingMessageId = null;
        _saveLabel = string.Empty;
    }

    private void HandleSaveLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelSave();
    }

    private void ToggleWorkIqModal()
    {
        _showWorkIqModal = !_showWorkIqModal;
    }

    private void OpenWorkIqModalFromBanner()
    {
        _showWorkIqModal = true;
    }

    private async Task ToggleSavedModal()
    {
        _showSavedModal = !_showSavedModal;
        _viewingItem = null;
        if (_showSavedModal)
        {
            _savedItems = null;
            StateHasChanged();
            try
            {
                var response = await ProxyService.ListSavedResponsesAsync();
                _savedItems = response?.Items ?? (IReadOnlyList<SavedResponseSummary>)[];
            }
            catch
            {
                _savedItems = [];
            }
        }
    }

    private async Task LoadSavedItem(string id)
    {
        _showSavedModal = false;
        _viewingItem = null;
        try
        {
            var response = await ProxyService.GetSavedResponseAsync(id);
            if (response is not null && response.Found)
                ChatState.AddSavedReference(response.Id, response.Label, response.Content, response.AgentName);
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Could not load saved response: {ex.Message}");
        }
    }

    private async Task ViewSavedItem(string id)
    {
        try
        {
            var response = await ProxyService.GetSavedResponseAsync(id);
            if (response is not null && response.Found)
                _viewingItem = response;
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Could not load saved response: {ex.Message}");
        }
    }

    private void BackToSavedList()
    {
        _viewingItem = null;
    }

    private void InsertViewedItem()
    {
        if (_viewingItem is null) return;
        ChatState.AddSavedReference(_viewingItem.Id, _viewingItem.Label, _viewingItem.Content, _viewingItem.AgentName);
        _viewingItem = null;
        _showSavedModal = false;
    }

    private async Task DeleteSavedItem(string id)
    {
        try
        {
            await ProxyService.DeleteSavedResponseAsync(id);
            _savedItems = _savedItems?.Where(i => i.Id != id).ToList();
        }
        catch (Exception ex)
        {
            ChatState.AddError($"Could not delete saved response: {ex.Message}");
        }
    }

    private void DismissSavedReference(ChatMessage message)
    {
        if (message.SavedResponseId is not null)
            ChatState.RemoveSavedReference(message.SavedResponseId);
    }

    public void Dispose()
    {
        ChatState.OnStateChanged -= _stateChangedHandler;
        ProxyService.OnConnectionChanged -= _connectionChangedHandler;
    }
}
