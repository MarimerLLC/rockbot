@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using RockBot.UserProxy.Blazor.Auth
@using RockBot.UserProxy.Blazor.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@inject UserProxyService ProxyService
@inject ChatStateService ChatState
@inject IJSRuntime JSRuntime
@implements IDisposable

@{
    // One snapshot per render: every part of the page shows the same state, even while events
    // are being applied on other threads.
    var state = ChatState.State;
    var isBusy = state.IsBusy(ChatState.UtcNow);

    // What this view draws: Simple leaves the agent's working detail out of the transcript (#828).
    var visibleMessages = ChatVisibility.VisibleMessages(state, _detailLevel, ChatState.UtcNow);
    _drawnMessageCount = visibleMessages.Count;

    // What's running and what finished, per kind: the header slots and the activity panel.
    var digest = ActivityDigest.From(state, ChatState.UtcNow);
}

<PageTitle>@(state.AgentName ?? "RockBot") Chat</PageTitle>

<div class="chat-container d-flex flex-column">
    @* While a dialog (saved responses, agent info) is open everything behind it is inert, so focus
       and the reading order stay inside the dialog (what its aria-modal promises). *@
    <header class="chat-header" inert="@ModalOpen">
        <h1 class="chat-title">
            <img class="brand-mark" src="@Assets["images/rockbot-mark-64.png"]"
                 srcset="@Assets["images/rockbot-mark-64.png"] 1x, @Assets["images/rockbot-mark-128.png"] 2x"
                 width="30" height="30" alt="" />
            <span class="chat-title-text">@(state.AgentName ?? "RockBot") Chat</span>
        </h1>
        <div class="status-row">
            @{
                var subagents = digest.Subagents.Running;
                var a2aCalls = digest.A2A.Running;
                var tasks = digest.Scheduled.Running;
            }
            @* Fixed order, every slot always present: the row is the status map. Each slot opens the
               activity panel on its tab, idle or not (the panel also lists finished work). *@
            <div class="activity-row" role="group" aria-label="Background activity">
                <ActivityIcon Kind="agent" Active="isBusy"
                              Title="@(isBusy ? state.ThinkingMessage ?? "RockBot is working…" : "RockBot is idle")"
                              OnClick="() => ToggleActivityPanel(ActivityKind.Agent)"
                              Expanded="_openActivity == ActivityKind.Agent" Controls="@ActivityPanelId" />
                <ActivityIcon Kind="subagent" Active="subagents.Count > 0" Count="subagents.Count"
                              Title="@ActivityTitle("No subagents running", subagents.Select(DescribeSubagent))"
                              OnClick="() => ToggleActivityPanel(ActivityKind.Subagent)"
                              Expanded="_openActivity == ActivityKind.Subagent" Controls="@ActivityPanelId" />
                <ActivityIcon Kind="a2a" Active="a2aCalls.Count > 0" Count="a2aCalls.Count"
                              Title="@ActivityTitle("No inbound A2A calls", a2aCalls.Select(a => $"Inbound A2A: {a.Status}"))"
                              OnClick="() => ToggleActivityPanel(ActivityKind.A2A)"
                              Expanded="_openActivity == ActivityKind.A2A" Controls="@ActivityPanelId" />
                <ActivityIcon Kind="scheduled" Active="tasks.Count > 0" Count="tasks.Count"
                              Title="@ActivityTitle("No background tasks", tasks.Select(t => $"Background task: {t.Status}"))"
                              OnClick="() => ToggleActivityPanel(ActivityKind.Scheduled)"
                              Expanded="_openActivity == ActivityKind.Scheduled" Controls="@ActivityPanelId" />
            </div>
            <ConnectionPill Connected="ProxyService.IsConnected" AppVersion="@UiVersion" AgentVersion="@state.AgentVersion"
                            OnShowDetails="OpenInfoDialog" />
            <button type="button" class="icon-btn info-btn" @onclick="OpenInfoDialog"
                    title="Agent info: models and pricing" aria-label="Agent info" aria-haspopup="dialog">
                <RbIcon Name="info" Size="15" />
            </button>
            <button type="button" class="icon-btn" @onclick="ToggleSavedModal"
                    title="Saved responses" aria-label="Saved responses">
                <RbIcon Name="bookmark" Size="14" />
            </button>
            @* Simple ↔ Detailed view. The label stays put; aria-pressed carries the state. *@
            <button type="button" class="icon-btn" @onclick="ToggleDetailLevel"
                    aria-pressed="@(IsDetailed ? "true" : "false")" aria-label="Show agent details"
                    title="@(IsDetailed ? "Detailed view: showing agent details" : "Simple view: show agent details")">
                <RbIcon Name="list-tree" Size="15" />
            </button>
            <button type="button" class="icon-btn" @onclick="ToggleDarkMode"
                    title="Toggle dark/light mode" aria-label="@(IsDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                @(IsDarkMode ? "☀️" : "🌙")
            </button>
            @* A real form POST rather than a link: signing out changes state, and the antiforgery
               middleware is what keeps another site from doing it to you.
               The explicit IsAuthenticated check is load-bearing: with Auth:Enabled=false the
               default policy succeeds for everyone, so AuthorizeView alone would render a Sign out
               button for an anonymous visitor, posting to an endpoint that is not even mapped. *@
            <AuthorizeView>
                <Authorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                    <form method="post" action="/auth/logout" class="d-inline">
                        <AntiforgeryToken />
                        <button type="submit" class="icon-btn text-btn"
                                title="@($"Sign out {UserAllowlist.GetEmail(context.User)}")"
                                aria-label="Sign out">
                            <span class="label-wide">Sign out</span>
                            <RbIcon Name="log-out" Size="14" Class="label-narrow" />
                        </button>
                    </form>
                    }
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <div inert="@ModalOpen"><McpSignInBanner /></div>

    @if (_openActivity is { } openActivity)
    {
        @* In the page flow under the header: it pushes the messages down, never floats over them. *@
        <div inert="@ModalOpen">
            <ActivityPanel Id="@ActivityPanelId" Kind="openActivity" Digest="digest" DisplayZone="_displayZone"
                           OnKindChanged="kind => _openActivity = kind" OnClose="CloseActivityPanel" />
        </div>
    }

    <div class="chat-messages flex-grow-1" inert="@ModalOpen" @ref="messagesContainer">
        @foreach (var message in visibleMessages)
        {
            @if (message.IsActivityLog)
            {
                <!-- Activity log bubble: collapsed one-liner with spinner, expandable to full log -->
                <div class="message-wrapper agent-message">
                    <CategoryAvatar Kind="@CategoryKind(message.Category)" />
                    <div class="message-bubble activity-log-bubble category-@message.Category.ToString().ToLowerInvariant() @(message.IsExpanded ? "expanded" : "collapsed")"
                         @onclick="() => ToggleExpanded(message.MessageId)">
                        @* The bubble's own click toggles; the header is the keyboard way in. *@
                        <div class="activity-log-header" role="button" tabindex="0"
                             aria-expanded="@(message.IsExpanded ? "true" : "false")"
                             @onkeydown="e => ToggleExpandedByKey(e, message.MessageId)">
                            <RbIcon Name="chevron-right" Size="12" Class="@($"chevron-indicator {(message.IsExpanded ? "open" : "")}")" />
                            @if (state.IsActivityLogOpen(message.MessageId))
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            @if (message.Category != MessageCategory.PrimaryProgress)
                            {
                                <span class="category-badge">@GetCategoryLabel(message.Category)</span>
                            }
                            @if (!string.IsNullOrEmpty(message.AgentName))
                            {
                                <span class="collapsible-agent-name">@message.AgentName</span>
                            }
                            <span class="activity-log-summary">@TruncateText(message.Content, 80)</span>
                            <span class="activity-log-count">(@(message.ActivityLogEntries.Count))</span>
                        </div>
                        @if (message.IsExpanded)
                        {
                            <ActivityLogEntries Entries="message.ActivityLogEntries" DisplayZone="_displayZone" />
                        }
                    </div>
                </div>
            }
            else if (IsCollapsibleCategory(message.Category))
            {
                <!-- Collapsible bubble: compact header when collapsed, full content when expanded -->
                <div class="message-wrapper agent-message">
                    <CategoryAvatar Kind="@CategoryKind(message.Category)" />
                    <div class="message-bubble collapsible-bubble category-@message.Category.ToString().ToLowerInvariant() @(message.IsExpanded ? "expanded" : "collapsed")">
                        <div class="collapsible-header" role="button" tabindex="0"
                             aria-expanded="@(message.IsExpanded ? "true" : "false")"
                             @onclick="() => ToggleExpanded(message.MessageId)" @onclick:stopPropagation="true"
                             @onkeydown="e => ToggleExpandedByKey(e, message.MessageId)">
                            <RbIcon Name="chevron-right" Size="12" Class="@($"chevron-indicator {(message.IsExpanded ? "open" : "")}")" />
                            <span class="category-badge">@GetCategoryLabel(message.Category)</span>
                            @if (!string.IsNullOrEmpty(message.AgentName))
                            {
                                <span class="collapsible-agent-name">@message.AgentName</span>
                            }
                            @if (!message.IsExpanded)
                            {
                                <span class="collapsible-preview">@TruncateText(message.Content, 80)</span>
                            }
                        </div>
                        @if (message.IsExpanded)
                        {
                            <div class="message-content mt-2">
                                @((MarkupString)SafeMarkdownRenderer.RenderSafe(DisplayContent(message)))
                            </div>
                            <AttachmentList Attachments="message.Attachments" />
                            <div class="message-time">
                                @DisplayTime(message)
                            </div>
                        }
                    </div>
                </div>
            }
            else if (message.Category == MessageCategory.SavedReference)
            {
                <!-- Saved reference bubble: distinct accent styling with dismiss button -->
                <div class="message-wrapper agent-message">
                    <CategoryAvatar Kind="saved" />
                    <div class="message-bubble saved-reference-bubble">
                        <div class="saved-badge-header">
                            <span class="category-badge saved-badge">Saved</span>
                            <span class="saved-label">@message.SavedResponseLabel</span>
                            <button type="button" class="btn-feedback" title="Dismiss" aria-label="Dismiss saved reference"
                                    @onclick="() => DismissSavedReference(message)">
                                <RbIcon Name="x" Size="14" />
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(message.AgentName))
                        {
                            <div class="message-agent-name">@message.AgentName</div>
                        }
                        <div class="message-content mt-2">
                            @((MarkupString)SafeMarkdownRenderer.RenderSafe(message.Content))
                        </div>
                    </div>
                </div>
            }
            else if (message.Category == MessageCategory.McpQuestion)
            {
                <!-- A question an MCP server handed back, answered in a form built from its schema -->
                <div class="message-wrapper agent-message">
                    @* An MCP server is asking, not RockBot: no RB mark. *@
                    <CategoryAvatar />
                    <div class="message-bubble mcp-question-bubble">
                        <McpQuestionCard Message="message" DisplayZone="_displayZone" OnSubmit="SubmitMcpAnswer" />
                    </div>
                </div>
            }
            else
            {
                <!-- Standard expanded bubble: user input, primary final, scheduled user, error -->
                <div class="message-wrapper @(message.IsFromUser ? "user-message" : "agent-message")">
                    @if (!message.IsFromUser)
                    {
                        @* Orange "RB" marks RockBot itself speaking; interim and error lines, and other
                           agents' replies, keep the indent without it. *@
                        <CategoryAvatar Kind="@(message.IsInterim || message.IsError || !IsPrimaryAgent(message, state) ? null : "agent")" />
                    }
                    <div class="message-bubble @BubbleVariant(message)">
                        @if (!message.IsFromUser && !message.IsError && !string.IsNullOrEmpty(message.AgentName))
                        {
                            <div class="message-agent-name">@message.AgentName</div>
                        }
                        <div class="message-content">
                            @((MarkupString)SafeMarkdownRenderer.RenderSafe(DisplayContent(message)))
                        </div>
                        <AttachmentList Attachments="message.Attachments" />
                        <div class="message-time">
                            @DisplayTime(message)
                        </div>
                        @if (!message.IsFromUser && !message.IsError)
                        {
                            <div class="feedback-bar">
                                <button type="button" class="btn-feedback @(message.Feedback == FeedbackState.ThumbsUp ? "active" : "")"
                                        title="This was helpful" aria-label="This was helpful"
                                        aria-pressed="@(message.Feedback == FeedbackState.ThumbsUp ? "true" : "false")"
                                        disabled="@(message.Feedback != FeedbackState.None)"
                                        @onclick="() => SendFeedback(message, isPositive: true)">
                                    <RbIcon Name="thumbs-up" Size="15" />
                                </button>
                                <button type="button" class="btn-feedback @(message.Feedback == FeedbackState.ThumbsDown ? "active" : "")"
                                        title="This wasn't helpful — please try again" aria-label="This wasn't helpful — please try again"
                                        aria-pressed="@(message.Feedback == FeedbackState.ThumbsDown ? "true" : "false")"
                                        disabled="@(message.Feedback != FeedbackState.None)"
                                        @onclick="() => SendFeedback(message, isPositive: false)">
                                    <RbIcon Name="thumbs-down" Size="15" />
                                </button>
                                @if (message.Category == MessageCategory.PrimaryFinal)
                                {
                                    <button type="button" class="btn-feedback save-btn @(_savingMessageId == message.MessageId ? "active" : "")"
                                            title="Save this response" aria-label="Save this response"
                                            @onclick="() => StartSaveFlow(message)">
                                        <RbIcon Name="bookmark" Size="15" Filled="_savingMessageId == message.MessageId" />
                                    </button>
                                }
                            </div>
                            @if (_savingMessageId == message.MessageId)
                            {
                                <div class="save-label-input">
                                    <input type="text" class="form-control form-control-sm" placeholder="Label this response..."
                                           aria-label="Label for the saved response"
                                           @bind="_saveLabel" @bind:event="oninput"
                                           @onkeydown="HandleSaveLabelKeyDown" />
                                    <button class="btn btn-sm btn-primary" @onclick="() => ConfirmSave(message)"
                                            disabled="@string.IsNullOrWhiteSpace(_saveLabel)">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelSave">Cancel</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }

        @{
            // Only a log that is still receiving entries carries its own spinner. Testing
            // for a collapsed bubble instead would match every finished turn's leftover
            // log and suppress this indicator for the rest of the conversation. Simple view
            // draws no logs, so there the thinking line shows whenever the agent is busy.
            var hasActiveActivityLog = IsDetailed && state.HasOpenActivityLog;
        }
        @if ((isBusy && !hasActiveActivityLog) || (!isBusy && !string.IsNullOrEmpty(state.ThinkingMessage)))
        {
            <div class="message-wrapper agent-message">
                <CategoryAvatar />
                <div class="message-bubble interim-message thinking-bubble">
                    <div class="thinking-indicator">
                        <span class="category-badge thinking-badge">Thinking</span>
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        @if (!string.IsNullOrEmpty(state.ThinkingMessage))
                        {
                            <span>@state.ThinkingMessage</span>
                        }
                        else
                        {
                            <span>Thinking...</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* The transcript this browser last showed, on screen while the page catches up with the server
       (chat.js fills it; Blazor must never render children into it). Hidden unless restoring. *@
    <div class="chat-messages chat-snapshot flex-grow-1" inert="@ModalOpen"></div>

    @{
        var plans = ChatVisibility.VisibleTaskLists(state, _detailLevel);
    }
    @if (plans.Count > 0)
    {
        <!-- The agent's plans: the primary turn's task list, and (Detailed) any running subagent's -->
        <div class="plan-panel" inert="@ModalOpen">
            @foreach (var list in plans)
            {
                <div class="plan-list">
                    <div class="plan-title">
                        @(list.Key == ReplySourceKind.Primary ? "Plan" : $"Subagent {list.Key} plan")
                        <span class="plan-progress">@list.CompletedCount/@list.Items.Count</span>
                    </div>
                    @foreach (var item in list.Items)
                    {
                        <label class="plan-item plan-item-@item.Status.Replace('_', '-')">
                            <input type="checkbox" disabled checked="@(item.Status == TaskListStatus.Completed)" />
                            <span>@item.Description</span>
                        </label>
                    }
                </div>
            }
        </div>
    }

    @if (_showSavedModal)
    {
        <div class="modal-overlay" @onclick="ToggleSavedModal">
            <div class="saved-modal" role="dialog" aria-modal="true" aria-label="Saved responses" tabindex="-1"
                 @ref="_savedModal" @onkeydown="HandleSavedModalKeyDown" @onclick:stopPropagation="true">
                @if (_viewingItem is not null)
                {
                    <div class="saved-view-header">
                        <h5>@_viewingItem.Label</h5>
                        <small class="saved-item-meta">@_viewingItem.AgentName — @TimeZoneInfo.ConvertTime(_viewingItem.SavedAt, _displayZone).ToString("MMM d, yyyy h:mm tt")</small>
                    </div>
                    <div class="saved-view-content">
                        @((MarkupString)SafeMarkdownRenderer.RenderSafe(_viewingItem.Content))
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-secondary" @onclick="BackToSavedList">Back</button>
                        <button class="btn btn-sm btn-primary" @onclick="() => InsertViewedItem()">Insert into chat</button>
                    </div>
                }
                else
                {
                    <h5>Saved Responses</h5>
                    @if (_savedItems is null)
                    {
                        <p>Loading...</p>
                    }
                    else if (_savedItems.Count == 0)
                    {
                        <p class="text-muted">No saved responses yet.</p>
                    }
                    else
                    {
                        @foreach (var item in _savedItems)
                        {
                            <div class="saved-item d-flex justify-content-between align-items-center p-2 mb-1 rounded">
                                <div class="saved-item-info" @onclick="() => LoadSavedItem(item.Id)" style="cursor:pointer;" title="Insert into chat">
                                    <strong>@item.Label</strong>
                                    <small class="saved-item-meta d-block">@item.AgentName@(DescribeSavedSource(item.Source)) — @TimeZoneInfo.ConvertTime(item.SavedAt, _displayZone).ToString("MMM d, yyyy h:mm tt")</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <button type="button" class="row-icon-btn" @onclick="() => ViewSavedItem(item.Id)"
                                            title="View" aria-label="@($"View {item.Label}")">
                                        <RbIcon Name="eye" Size="15" />
                                    </button>
                                    <button type="button" class="row-icon-btn danger" @onclick="() => DeleteSavedItem(item.Id)"
                                            title="Delete" aria-label="@($"Delete {item.Label}")">
                                        <RbIcon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    <button class="btn btn-sm btn-secondary mt-2" @onclick="ToggleSavedModal">Close</button>
                }
            </div>
        </div>
    }

    @if (_showInfoDialog)
    {
        <AgentInfoDialog AgentName="@state.AgentName" AgentVersion="@state.AgentVersion" AppVersion="@UiVersion"
                         DisplayZone="_displayZone" ThreadId="@SessionId" OnClose="CloseInfoDialog" />
    }

    <div class="composer" inert="@ModalOpen">
        @if (_stagedAttachments.Count > 0 || _attachmentError is not null || _isUploading)
        {
            <div class="staged-attachments">
                @foreach (var staged in _stagedAttachments)
                {
                    <span class="staged-chip">
                        <RbIcon Name="paperclip" Size="12" />
                        <span class="staged-chip-name">@(staged.FileName ?? staged.Path)</span>
                        <button type="button" class="staged-chip-remove"
                                aria-label="@($"Remove {staged.FileName ?? staged.Path}")"
                                @onclick="() => RemoveAttachment(staged)">
                            <RbIcon Name="x" Size="12" />
                        </button>
                    </span>
                }
                @if (_isUploading)
                {
                    <span class="staged-status">Uploading…</span>
                }
                @if (_attachmentError is not null)
                {
                    <span class="staged-error">@_attachmentError</span>
                }
            </div>
        }
        <form @onsubmit="SendMessage" @onsubmit:preventDefault="true" class="composer-row">
            @* A label, so the whole button opens the file picker; the visually hidden input keeps
               it keyboard-reachable (focus-within draws the ring on the label). *@
            <label class="btn-ghost composer-attach @(isBusy ? "disabled" : null)" title="Attach a file">
                <RbIcon Name="paperclip" Size="18" />
                <span class="visually-hidden">Attach a file</span>
                <InputFile OnChange="StageAttachmentsAsync" multiple class="visually-hidden"
                           accept="@AcceptedFileTypes" disabled="@isBusy" />
            </label>
            <textarea
                class="form-control"
                placeholder="Type your message..."
                @bind="currentMessage"
                @bind:event="oninput"
                @ref="messageInput"
                @onkeydown="HandleKeyDown"
                disabled="@isBusy"
                rows="1"
                aria-label="Message input"></textarea>
            @if (isBusy)
            {
                <button
                    type="button"
                    class="btn-ghost composer-cancel"
                    @onclick="CancelSession"
                    title="Cancel current work"
                    aria-label="Cancel current work">
                    <span class="label-wide">Cancel</span>
                    <RbIcon Name="x" Size="18" Class="label-narrow" />
                </button>
            }
            <button
                type="submit"
                class="btn-send"
                disabled="@((string.IsNullOrWhiteSpace(currentMessage) && _stagedAttachments.Count == 0) || isBusy || _isUploading || !ProxyService.IsConnected)"
                title="Send message"
                aria-label="Send message">
                <span class="label-wide">Send</span>
                <RbIcon Name="send" Size="18" Class="label-narrow" />
            </button>
        </form>
    </div>
</div>

@code {
    private const string SessionId = "blazor-session";
    private const string UserId = "blazor-user";

    private static readonly string UiVersion = AssemblyVersion.Current;

    private string currentMessage = string.Empty;

    // Files the user has picked for the next message. Each was uploaded to the agent as soon
    // as it was picked, so these are path references, not bytes.
    private readonly List<AgentAttachment> _stagedAttachments = [];
    private bool _isUploading;
    private string? _attachmentError;

    /// <summary>
    /// What the picker offers. Mirrors the agent's own allowlist — the agent re-checks and is
    /// the authority; this only spares the user a round trip to be told no.
    /// </summary>
    private const string AcceptedFileTypes = ".png,.jpg,.jpeg,.gif,.webp,.bmp,.pdf";

    /// <summary>
    /// Matches the agent's cap. Blazor's OpenReadStream defaults to 512 KB and throws past it,
    /// so this has to be passed explicitly or every real screenshot fails.
    /// </summary>
    private const long MaxAttachmentBytes = AttachmentUploadRequest.MaxBytes;
    private ElementReference messagesContainer;
    private ElementReference messageInput;
    private bool IsDarkMode = false;
    private TimeZoneInfo _displayZone = TimeZoneInfo.Utc;

    /// <summary>A bubble's markdown, with its origin anchor in this browser's zone.</summary>
    private string DisplayContent(ChatMessage message) =>
        MessageDisplay.Content(message, SessionId, new DateTimeOffset(ChatState.UtcNow, TimeSpan.Zero), _displayZone);

    /// <summary>A bubble's timestamp in this browser's zone, dated when it isn't from today.</summary>
    private string DisplayTime(ChatMessage message) =>
        MessageDisplay.Time(message.Timestamp, ChatState.UtcNow, _displayZone);

    private Action? _stateChangedHandler;
    private Action? _connectionChangedHandler;
    private int _renderedMessageCount = 0;

    // Simple (the default) or Detailed: what the transcript draws. Per view, not chat state —
    // ChatStateService is shared by every browser. Remembered in the browser's localStorage.
    private ChatDetailLevel _detailLevel = ChatDetailLevel.Simple;
    private bool IsDetailed => _detailLevel == ChatDetailLevel.Detailed;

    // How many messages the last render drew, and whether the next render follows a view switch
    // (which changes the count without anything new arriving, so it mustn't scroll).
    private int _drawnMessageCount;
    private bool _viewSwitched;

    // True until the first render's loads (detail level, history, status) are done. Meanwhile the
    // browser shows its saved snapshot, positioned by chat.js, so nothing here scrolls; ending it
    // swaps the live transcript in at the same place.
    private bool _restoring = true;

    // Simple view shows a subagent result RockBot never answered once its grace runs out, with
    // no event to prompt a render then; this timer prompts it.
    private Timer? _visibilityTimer;
    private DateTime? _visibilityRenderAt;

    // Save flow state
    private string? _savingMessageId;
    private string _saveLabel = string.Empty;
    private bool _showSavedModal;
    private IReadOnlyList<SavedResponseSummary>? _savedItems;
    private ElementReference _savedModal;

    // Set when the dialog opens or swaps its content (list ↔ one item), which would otherwise
    // drop focus to the inert page behind it; the next render moves focus onto the dialog.
    private bool _focusSavedModal;

    // The agent info dialog (#834). It asks the agent itself when it opens.
    private bool _showInfoDialog;
    private bool _focusInfoButton;

    /// <summary>A dialog is open: everything behind it is inert.</summary>
    private bool ModalOpen => _showSavedModal || _showInfoDialog;

    /// <summary>
    /// Marks entries the user didn't save themselves (#418): results saved automatically when
    /// background work finished, and the agent's own saves.
    /// </summary>
    internal static string DescribeSavedSource(string? source) => source switch
    {
        null or "" or "user" => string.Empty,
        "agent" => " · saved by agent",
        "background-task" => " · auto-saved (background task)",
        "a2a" => " · auto-saved (agent reply)",
        _ => $" · auto-saved ({source})",
    };
    private GetSavedResponseResponse? _viewingItem;

    private string? _lastRenderedAgentName;

    /// <summary>
    /// Cancels the local wait for the in-flight send. The agent publishes no correlated
    /// final reply for a cancelled turn, so without this the pending request would sit
    /// until the reply timeout and keep the input locked.
    /// </summary>
    private CancellationTokenSource? _sendCts;

    protected override void OnInitialized()
    {
        _stateChangedHandler = () => InvokeAsync(StateHasChanged);
        ChatState.OnStateChanged += _stateChangedHandler;

        _connectionChangedHandler = () => InvokeAsync(StateHasChanged);
        ProxyService.OnConnectionChanged += _connectionChangedHandler;

        _visibilityTimer = new Timer(_ => InvokeAsync(() =>
        {
            _visibilityRenderAt = null;
            StateHasChanged();
        }));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // PageTitle doesn't reliably re-render on state changes, so sync via JS
        var currentName = ChatState.State.AgentName ?? "RockBot";
        if (_lastRenderedAgentName != currentName)
        {
            _lastRenderedAgentName = currentName;
            await JSRuntime.InvokeVoidAsync("chatHelpers.setPageTitle", $"{currentName} Chat");
        }

        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("chatHelpers.preventEnterNewline", messageInput);
            await JSRuntime.InvokeVoidAsync("chatHelpers.initInputHistory", messageInput);
            await JSRuntime.InvokeVoidAsync("chatHelpers.focusInputOnWindowFocus", messageInput);

            var tzId = await JSRuntime.InvokeAsync<string>("chatHelpers.getBrowserTimezone");
            try { _displayZone = TimeZoneInfo.FindSystemTimeZoneById(tzId); }
            catch { _displayZone = TimeZoneInfo.Utc; }

            // The view this browser last chose; the render below picks it up.
            var level = await JSRuntime.InvokeAsync<string>("chatHelpers.getDetailLevel");
            _detailLevel = level == "detailed" ? ChatDetailLevel.Detailed : ChatDetailLevel.Simple;

            // The theme is already on the page (App.razor's inline script); the toggle follows it.
            IsDarkMode = await JSRuntime.InvokeAsync<bool>("chatHelpers.isDarkMode");
            StateHasChanged();

            // Load history after the real SignalR circuit is established.
            // This runs only on first render (never during static prerendering),
            // which avoids a 10-second blank-page wait and prevents duplicate
            // messages when the singleton ChatStateService outlives the component.
            try
            {
                var info = await ProxyService.GetAgentInfoAsync(timeout: TimeSpan.FromSeconds(5));
                if (info is not null)
                    ChatState.Apply(new AgentInfoReceived(info.AgentName, info.AgentVersion));
            }
            catch { /* non-fatal — header falls back to defaults */ }

            try
            {
                // With the broadcast sessions' output (#809): this view shows it live, so a
                // reload has to bring it back too.
                var history = await ProxyService.GetHistoryAsync(SessionId, timeout: TimeSpan.FromSeconds(10),
                    includeBroadcast: true);
                if (history is not null && history.Turns.Count > 0)
                    ChatState.Apply(BlazorUserFrontend.HistoryEvent(history, SessionId, DateTimeOffset.UtcNow));
            }
            catch (Exception ex)
            {
                ChatState.Apply(new ErrorReported($"Could not load conversation history: {ex.Message}"));
            }

            // The transcript has caught up (or can't): the live one replaces the snapshot.
            await EndRestoreAsync();

            // Reconcile active status indicators against the agent's ground truth.
            // This clears stale subagent spinners/header badges that persist in the
            // singleton ChatStateService across page reloads, and seeds indicators
            // for subagents that started before this UI connected.
            try
            {
                var status = await ProxyService.GetActiveStatusAsync(SessionId, timeout: TimeSpan.FromSeconds(5));
                if (status is not null)
                    ChatState.Apply(new ActiveStatusReconciled(status));
            }
            catch { /* non-fatal — stale indicators clear on next user message */ }
        }

        if (_focusSavedModal && _showSavedModal)
        {
            _focusSavedModal = false;
            await _savedModal.FocusAsync();
        }

        if (_focusInfoButton && !ModalOpen)
        {
            _focusInfoButton = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("chatHelpers.focusSelector", ".chat-header .info-btn");
            }
            catch (JSException)
            {
                // Focus stays where the browser puts it.
            }
        }

        // Only scroll when a new message has been drawn — not on every re-render (theme toggles,
        // or a message Simple view leaves out, should not move the scroll position), and not
        // when a view switch changed what is drawn. Scroll to the TOP of the new message so long
        // responses are read top-to-bottom. The count follows the drawn transcript down too
        // (a /clear, a switch to Simple), so the next new message still scrolls. While the page
        // is restoring, what arrives is the transcript catching up, not something new: chat.js
        // keeps it where the reader was.
        var drawn = _drawnMessageCount;
        var grew = drawn > _renderedMessageCount && !_viewSwitched && !_restoring;
        _renderedMessageCount = drawn;
        _viewSwitched = false;
        if (grew)
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "var msgs = document.querySelectorAll('.message-wrapper'); if (msgs.length) msgs[msgs.length - 1].scrollIntoView({ behavior: 'smooth', block: 'start' });");
        }

        ScheduleVisibilityRender(ChatVisibility.NextVisibilityChange(ChatState.State, _detailLevel, ChatState.UtcNow));
    }

    /// <summary>
    /// Swaps the browser's saved snapshot for the live transcript, once (chat.js keeps the scroll
    /// position across the swap). From here on new messages scroll into view as usual.
    /// </summary>
    private async Task EndRestoreAsync()
    {
        if (!_restoring)
            return;

        _restoring = false;
        _renderedMessageCount = _drawnMessageCount;
        try
        {
            await JSRuntime.InvokeVoidAsync("chatHelpers.endRestore");
        }
        catch (JSException)
        {
            // chat.js didn't load: there was no snapshot on screen to swap out.
        }
    }

    /// <summary>Arms the timer for the next time Simple view draws something with no event to prompt it.</summary>
    private void ScheduleVisibilityRender(DateTime? at)
    {
        if (at == _visibilityRenderAt)
            return;

        _visibilityRenderAt = at;
        var due = at is { } when
            ? (when - ChatState.UtcNow) + TimeSpan.FromMilliseconds(50)
            : Timeout.InfiniteTimeSpan;
        _visibilityTimer?.Change(due < TimeSpan.Zero ? TimeSpan.Zero : due, Timeout.InfiniteTimeSpan);
    }

    private async Task ToggleDetailLevel()
    {
        _detailLevel = IsDetailed ? ChatDetailLevel.Simple : ChatDetailLevel.Detailed;
        _viewSwitched = true;
        try
        {
            await JSRuntime.InvokeVoidAsync("chatHelpers.setDetailLevel", IsDetailed ? "detailed" : "simple");
        }
        catch (JSException)
        {
            // Not remembered; this page still switches.
        }
    }

    private async Task CancelSession()
    {
        // Release the UI immediately — the agent stops the in-flight turn and never
        // publishes a correlated final reply for it, so there is nothing left to wait
        // for. A new user message cancels the prior session generation anyway, so the
        // user is free to send again right away.
        var cts = _sendCts;
        _sendCts = null;
        ChatState.Apply(new UserCancelled());
        cts?.Cancel();

        try
        {
            await ProxyService.CancelSessionAsync(SessionId);
        }
        catch (Exception ex)
        {
            ChatState.Apply(new ErrorReported($"Could not cancel: {ex.Message}"));
        }

        await messageInput.FocusAsync();
    }

    /// <summary>
    /// Uploads each picked file to the agent and stages the path reference it returns. The agent
    /// owns every write to the shared volume — this pod mounts it read-only — so the bytes go
    /// over the bus once, here, and the message itself carries only the reference.
    /// </summary>
    private async Task StageAttachmentsAsync(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        _isUploading = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(maximumFileCount: 10))
            {
                if (file.Size > MaxAttachmentBytes)
                {
                    _attachmentError =
                        $"{file.Name} is {file.Size / 1024 / 1024.0:F1} MB, over the " +
                        $"{MaxAttachmentBytes / 1024 / 1024} MB limit.";
                    continue;
                }

                byte[] data;
                using (var stream = file.OpenReadStream(MaxAttachmentBytes))
                {
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer);
                    data = buffer.ToArray();
                }

                var response = await ProxyService.UploadAttachmentAsync(new AttachmentUploadRequest
                {
                    FileName = file.Name,
                    Mime = string.IsNullOrWhiteSpace(file.ContentType)
                        ? AttachmentPathResolver.GuessMime(file.Name)
                        : file.ContentType,
                    Data = data,
                    SessionId = SessionId,
                    UserId = UserId
                });

                if (response is null)
                {
                    _attachmentError = $"{file.Name} could not be sent — the agent did not respond.";
                }
                else if (!response.Success || response.Attachment is null)
                {
                    _attachmentError = response.Error ?? $"{file.Name} was not accepted.";
                }
                else
                {
                    _stagedAttachments.Add(response.Attachment);
                }
            }
        }
        catch (Exception ex)
        {
            _attachmentError = $"Could not attach: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void RemoveAttachment(AgentAttachment attachment)
    {
        // Drops it from this message only. The file stays on the shared volume — the agent
        // owns its lifetime, and nothing here has authority to delete it.
        _stagedAttachments.Remove(attachment);
        _attachmentError = null;
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) && _stagedAttachments.Count == 0)
            return;

        // Sent before the history has loaded: the message belongs on the live transcript, now.
        await EndRestoreAsync();

        var messageContent = currentMessage.Trim();
        currentMessage = string.Empty;
        await JSRuntime.InvokeVoidAsync("chatHelpers.addToHistory", messageInput, messageContent);

        // Handle /clear command — pure plumbing, no LLM involved
        if (messageContent.Equals("/clear", StringComparison.OrdinalIgnoreCase))
        {
            ChatState.Apply(new ConversationCleared());
            try
            {
                await ProxyService.ClearContextAsync(SessionId);
            }
            catch (Exception ex)
            {
                ChatState.Apply(new ErrorReported($"Could not clear agent context: {ex.Message}"));
            }
            return;
        }

        var attachments = _stagedAttachments.Count > 0 ? _stagedAttachments.ToList() : null;
        _stagedAttachments.Clear();
        _attachmentError = null;

        var turnId = ChatIds.New();
        ChatState.Apply(new UserMessageSent(messageContent, UserId, SessionId, attachments));
        ChatState.Apply(new TurnStarted(turnId));

        // If a saved reference is active, prepend it as context for the agent
        var savedRef = ChatState.State.ActiveSavedReference;
        string effectiveContent;
        if (savedRef is not null)
        {
            effectiveContent =
                $"[The user is referencing a previously saved agent response labeled \"{savedRef.SavedResponseLabel}\":]\n\n" +
                $"---\n{savedRef.Content}\n---\n\n" +
                messageContent;
        }
        else
        {
            effectiveContent = messageContent;
        }

        var message = new UserMessage
        {
            Content = effectiveContent,
            SessionId = SessionId,
            UserId = UserId,
            ClientCapabilities = ClientCapabilityPresets.Blazor,
            ChannelName = "blazor",
            Attachments = attachments
        };

        // Progress, heartbeats and the task list go straight into the chat state as they arrive.
        var observer = new ChatTurnObserver(ChatState, turnId);

        var sendCts = new CancellationTokenSource();
        _sendCts?.Dispose();
        _sendCts = sendCts;

        // The turn ends exactly once, however the send finishes. Ending it releases the busy
        // state only while it is still the current turn: a cancel or a newer send owns it otherwise.
        TurnEnded ended;
        try
        {
            // The turn id doubles as the correlation id, so the agent's run id is this turn's id.
            var result = await ProxyService.SendTurnAsync(message, new TurnOptions
            {
                CorrelationId = turnId,
                Progress = observer,
                Observer = observer,
            }, sendCts.Token);

            ended = ChatTurnObserver.ToTurnEnded(turnId, result);
        }
        catch (OperationCanceledException)
        {
            // Cancel button — CancelSession already released the UI and the agent
            // publishes its own "Cancelled." bubble. Nothing to report here.
            ended = new TurnEnded(turnId, TurnOutcome.Cancelled);
        }
        catch (Exception ex)
        {
            ended = new TurnEnded(turnId, TurnOutcome.Failed) { Error = ex.Message };
        }

        ChatState.Apply(ended);

        // Only this send's own end hands the input back. A cancel (which nulls _sendCts) or a
        // newer send owns it otherwise.
        if (ReferenceEquals(_sendCts, sendCts))
        {
            _sendCts = null;
            sendCts.Dispose();
            await messageInput.FocusAsync();
        }
    }

    private async Task SendFeedback(ChatMessage message, bool isPositive)
    {
        ChatState.Apply(new FeedbackRecorded(message.MessageId, isPositive));

        var feedback = new UserFeedback
        {
            SessionId = message.SessionId ?? SessionId,
            MessageId = message.MessageId,
            IsPositive = isPositive,
            AgentName = message.AgentName
        };

        try
        {
            await ProxyService.SendFeedbackAsync(feedback);
        }
        catch (Exception ex)
        {
            ChatState.Apply(new ErrorReported($"Could not send feedback: {ex.Message}"));
        }
    }

    private void ToggleExpanded(string messageId) =>
        ChatState.Apply(new MessageExpandToggled(messageId));

    // Keyboard equivalent of clicking a collapsible header (role="button"): Enter or Space.
    private void ToggleExpandedByKey(KeyboardEventArgs e, string messageId)
    {
        if (e.Key is "Enter" or " ")
            ToggleExpanded(messageId);
    }

    /// <summary>
    /// Whether a message is RockBot's own (the agent this UI talks to), and so earns the RB mark.
    /// Replies with no name are the primary agent's; any other name is another agent's.
    /// </summary>
    private static bool IsPrimaryAgent(ChatMessage message, ChatViewState state) =>
        string.IsNullOrEmpty(message.AgentName)
        || string.Equals(message.AgentName, state.AgentName ?? "RockBot", StringComparison.OrdinalIgnoreCase);

    // The user answered (or declined) a handed-back MCP question in its form. The answer goes to
    // the agent, which hands it straight to the bridge; the agent replies once the call resumes.
    private async Task SubmitMcpAnswer(McpQuestionSubmission submission)
    {
        // Starting the submit also marks the chat busy until the agent's follow-up arrives. That
        // wait is tracked apart from a turn still running, so the turn's reply can't end it.
        if (!ChatState.Apply(new McpAnswerSubmitted(submission.QuestionId)))
            return;

        try
        {
            await ProxyService.SendMcpAnswerAsync(new McpQuestionAnswer
            {
                SessionId = SessionId,
                UserId = UserId,
                QuestionId = submission.QuestionId,
                Answers = submission.AnswersJson,
                Decline = submission.Decline,
            });
        }
        catch (Exception ex)
        {
            ChatState.Apply(new McpAnswerFailed(submission.QuestionId, $"the answer couldn't be sent ({ex.Message})"));
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !e.CtrlKey)
            await SendMessage();
    }

    private static bool IsCollapsibleCategory(MessageCategory category)
        => category is MessageCategory.SubagentActivity
            or MessageCategory.A2AActivity
            or MessageCategory.ScheduledSystem;

    private static string GetCategoryLabel(MessageCategory category) => category switch
    {
        MessageCategory.SubagentActivity => "Subagent",
        MessageCategory.A2AActivity => "Inbound A2A",
        MessageCategory.ScheduledSystem => "Background Task",
        _ => "Agent"
    };

    /// <summary>
    /// The standard bubble's variant: an error notice, an interim line, a user message, or one of
    /// RockBot's own replies — the only kind that carries the orange agent accent.
    /// </summary>
    private static string BubbleVariant(ChatMessage message) =>
        message.IsError ? "error-message"
        : message.IsInterim ? "interim-message"
        : message.IsFromUser ? "user-bubble"
        : "agent-reply";

    /// <summary>The design system's category kind for a message's avatar, or null for none.</summary>
    private static string? CategoryKind(MessageCategory category) => category switch
    {
        MessageCategory.SubagentActivity => "subagent",
        MessageCategory.A2AActivity => "a2a",
        MessageCategory.ScheduledSystem => "scheduled",
        _ => null
    };

    /// <summary>A header activity slot's tooltip: one line per running item, or the idle text.</summary>
    private static string ActivityTitle(string idle, IEnumerable<string> lines)
    {
        var text = string.Join("\n", lines);
        return text.Length == 0 ? idle : text;
    }

    private static string DescribeSubagent(ActivityItem sub)
    {
        var name = ChatReducer.SubagentTaskId(sub.AgentName) ?? sub.AgentName ?? "subagent";
        return $"{(sub.IsWorker ? "Worker" : "Subagent")} {name}: {sub.Status}";
    }

    // ── Activity panel (#828) ──────────────────────────────────────────────

    private const string ActivityPanelId = "rb-activity-panel";

    /// <summary>The activity panel's open tab, or null while it's closed.</summary>
    private ActivityKind? _openActivity;

    /// <summary>A slot opens the panel on its tab, switches to it, or (its own tab open) closes it.</summary>
    private async Task ToggleActivityPanel(ActivityKind kind)
    {
        if (_openActivity == kind)
            await CloseActivityPanel();
        else
            _openActivity = kind;
    }

    /// <summary>Closes the panel and gives focus back to the slot of the tab that was open.</summary>
    private async Task CloseActivityPanel()
    {
        if (_openActivity is not { } kind)
            return;

        _openActivity = null;
        try
        {
            await JSRuntime.InvokeVoidAsync("chatHelpers.focusSelector", $".chat-header .activity-icon.{ActivityPanel.Css(kind)}");
        }
        catch (JSException)
        {
            // Focus stays where the browser puts it.
        }
    }

    private static string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        // Take first line, truncate if needed
        var firstLine = text.Split('\n', 2)[0];
        return firstLine.Length <= maxLength ? firstLine : firstLine[..(maxLength - 1)] + "\u2026";
    }

    // Remembered per browser, so the next load opens in the same theme before it is painted.
    private async Task ToggleDarkMode()
    {
        IsDarkMode = !IsDarkMode;
        await JSRuntime.InvokeVoidAsync("chatHelpers.setDarkMode", IsDarkMode);
    }

    // ── Save flow ──────────────────────────────────────────────────────────

    private void StartSaveFlow(ChatMessage message)
    {
        _savingMessageId = message.MessageId;
        _saveLabel = string.Empty;
    }

    private void CancelSave()
    {
        _savingMessageId = null;
        _saveLabel = string.Empty;
    }

    private async Task ConfirmSave(ChatMessage message)
    {
        if (string.IsNullOrWhiteSpace(_saveLabel)) return;

        var request = new SaveResponseRequest
        {
            Label = _saveLabel.Trim(),
            // With its origin anchor, dated, so the saved copy still says what it answered.
            Content = MessageDisplay.ForSaving(message, SessionId, _displayZone),
            AgentName = message.AgentName ?? "unknown",
            SessionId = message.SessionId ?? SessionId
        };

        try
        {
            await ProxyService.SaveResponseAsync(request);
        }
        catch (Exception ex)
        {
            ChatState.Apply(new ErrorReported($"Could not save response: {ex.Message}"));
        }

        _savingMessageId = null;
        _saveLabel = string.Empty;
    }

    private void HandleSaveLabelKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelSave();
    }

    private async Task HandleSavedModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await ToggleSavedModal();
    }

    private void OpenInfoDialog()
    {
        _showSavedModal = false;
        _showInfoDialog = true;
    }

    private void CloseInfoDialog()
    {
        _showInfoDialog = false;
        // Focus goes back to the info button once the render that lifts inert has landed.
        _focusInfoButton = true;
    }

    private async Task ToggleSavedModal()
    {
        _showSavedModal = !_showSavedModal;
        _viewingItem = null;
        if (_showSavedModal)
        {
            _focusSavedModal = true;
            _savedItems = null;
            StateHasChanged();
            try
            {
                var response = await ProxyService.ListSavedResponsesAsync();
                _savedItems = response?.Items ?? (IReadOnlyList<SavedResponseSummary>)[];
            }
            catch
            {
                _savedItems = [];
            }
        }
    }

    private async Task LoadSavedItem(string id)
    {
        _showSavedModal = false;
        _viewingItem = null;
        try
        {
            var response = await ProxyService.GetSavedResponseAsync(id);
            if (response is not null && response.Found)
                ChatState.Apply(new SavedReferenceAdded(response.Id, response.Label, response.Content, response.AgentName));
        }
        catch (Exception ex)
        {
            ChatState.Apply(new ErrorReported($"Could not load saved response: {ex.Message}"));
        }
    }

    private async Task ViewSavedItem(string id)
    {
        try
        {
            var response = await ProxyService.GetSavedResponseAsync(id);
            if (response is not null && response.Found)
            {
                _viewingItem = response;
                _focusSavedModal = true;
            }
        }
        catch (Exception ex)
        {
            ChatState.Apply(new ErrorReported($"Could not load saved response: {ex.Message}"));
        }
    }

    private void BackToSavedList()
    {
        _viewingItem = null;
        _focusSavedModal = true;
    }

    private void InsertViewedItem()
    {
        if (_viewingItem is null) return;
        ChatState.Apply(new SavedReferenceAdded(_viewingItem.Id, _viewingItem.Label, _viewingItem.Content, _viewingItem.AgentName));
        _viewingItem = null;
        _showSavedModal = false;
    }

    private async Task DeleteSavedItem(string id)
    {
        try
        {
            await ProxyService.DeleteSavedResponseAsync(id);
            _savedItems = _savedItems?.Where(i => i.Id != id).ToList();
        }
        catch (Exception ex)
        {
            ChatState.Apply(new ErrorReported($"Could not delete saved response: {ex.Message}"));
        }
    }

    private void DismissSavedReference(ChatMessage message)
    {
        if (message.SavedResponseId is not null)
            ChatState.Apply(new SavedReferenceRemoved(message.SavedResponseId));
    }

    public void Dispose()
    {
        ChatState.OnStateChanged -= _stateChangedHandler;
        ProxyService.OnConnectionChanged -= _connectionChangedHandler;
        _visibilityTimer?.Dispose();
        _visibilityTimer = null;
        _sendCts?.Dispose();
        _sendCts = null;
    }
}
