<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>McpServer.Gmail</RootNamespace>
    <UserSecretsId>mcpserver-gmail-9a4c2e7b-5f1d-4b8a-8c3e-1d7f6a2b9e4c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- MimeKit pulls in Pkcs 10.0.0, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\McpServer.TodoApp\StrictArguments.cs" Link="StrictArguments.cs" />
  </ItemGroup>

</Project>
