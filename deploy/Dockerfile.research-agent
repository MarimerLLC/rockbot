# syntax=docker/dockerfile:1
# Build stage — runs on the build host; -a $TARGETARCH publishes for the target platform
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0@sha256:0a506ab0c8aa077361af42f82569d364ab1b8741e967955d883e3f23683d473a AS build
ARG TARGETARCH
WORKDIR /src

# Clear Windows-specific NuGet fallback folders that break Linux builds
RUN printf '<configuration><fallbackPackageFolders><clear /></fallbackPackageFolders></configuration>' \
    > /src/NuGet.config

COPY RockBot.slnx Directory.Build.props ./
COPY src/ src/

# BuildKit cache mount avoids re-downloading packages on every build
RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet publish src/RockBot.ResearchAgent/RockBot.ResearchAgent.csproj \
    -c Release -a $TARGETARCH -o /app/publish

# Runtime stage — aspnet, not runtime: the research server hosts its MCP endpoint (/mcp) and
# health check (/health) on Kestrel, so it needs the Microsoft.AspNetCore.App framework.
FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:6a94333d37514e385650a3c81a55e5350b67253dbe136e9cf17e499c35606a8c AS runtime
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

# Non-root user
RUN groupadd -r rockbot && useradd -r -g rockbot rockbot

COPY --from=build /app/publish .

RUN chown -R rockbot:rockbot /app
USER rockbot

ENTRYPOINT ["dotnet", "RockBot.ResearchAgent.dll"]
