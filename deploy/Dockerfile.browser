# Headless-browser render service (RockBot.Browser), run as a sidecar in the agent pod.
#
# Build from the repo root:
#   docker build -f deploy/Dockerfile.browser -t rockylhotka/rockbot-browser:latest .
#
# Builds for the host's architecture by default; pass --platform linux/amd64 or
# linux/arm64 to target another one.

# The SDK stage runs natively on the build host and cross-publishes for the target RID,
# so a cross-architecture build only emulates the final stage.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
WORKDIR /src

# Clear Windows-specific NuGet fallback folders that break Linux builds
RUN printf '<configuration><fallbackPackageFolders><clear /></fallbackPackageFolders></configuration>' \
    > /src/NuGet.config

# Map the target architecture to a .NET RID (linux-x64 when TARGETARCH is unset).
RUN case "$TARGETARCH" in arm64) echo linux-arm64 ;; *) echo linux-x64 ;; esac > /rid

COPY Directory.Build.props .
COPY src/RockBot.Browser/RockBot.Browser.csproj src/RockBot.Browser/
RUN dotnet restore src/RockBot.Browser/RockBot.Browser.csproj -r "$(cat /rid)"

COPY src/RockBot.Browser/ src/RockBot.Browser/
# A Linux RID so the publish output carries only that platform's Playwright driver (node + cli).
RUN dotnet publish src/RockBot.Browser/RockBot.Browser.csproj -c Release -r "$(cat /rid)" \
    --self-contained false --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY --from=build /app/publish .

# Install the Chromium headless shell that this Microsoft.Playwright version expects, plus
# its system libraries, with the driver bundled in the package — no PowerShell needed.
# The publish output holds exactly one linux-* driver, the one for the target RID.
RUN NODE=$(echo /app/.playwright/node/linux-*/node) \
    && "$NODE" /app/.playwright/package/cli.js install --with-deps --only-shell chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /ms-playwright /app/.playwright \
    && chmod a+x "$NODE"

USER $APP_UID
ENV ASPNETCORE_URLS=http://+:8083
ENV ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8083
ENTRYPOINT ["dotnet", "RockBot.Browser.dll"]
