# Copy to .env and fill in your credentials:
#   cp deploy/docker-compose/a2a-peer/.env.example deploy/docker-compose/.env
#
# LLM is REQUIRED — without it agents use EchoChatClient and can't reason about tools.

# Option A: OpenAI-compatible (OpenRouter, OpenAI, etc.)
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_MODEL_ID=anthropic/claude-haiku-4.5

# Option B: GitHub Copilot SDK (uncomment and set GITHUB_TOKEN)
# LLM_PROVIDER=Copilot
# GITHUB_TOKEN=ghp_your-token-here
# LLM_MODEL_ID=gpt-4.1
