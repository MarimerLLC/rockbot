# A2A Peer Test — LLM credentials
#
# Copy this to the docker-compose directory and fill in your credentials:
#   cp deploy/docker-compose/a2a-peer/.env.example deploy/docker-compose/.env
#
# LLM is REQUIRED — without it agents use EchoChatClient and can't reason
# about tools (they'll just echo input back instead of calling invoke_agent).
#
# Both Alice and Bob agents share the same LLM configuration.

# ── Option A: OpenAI-compatible (OpenRouter, Azure OpenAI, etc.) ─────────────
LLM_ENDPOINT=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-your-key-here
LLM_MODEL_ID=anthropic/claude-haiku-4.5

# ── Option B: GitHub Copilot SDK ─────────────────────────────────────────────
# LLM_PROVIDER=Copilot
# GITHUB_TOKEN=ghp_your-token-here
# LLM_MODEL_ID=gpt-4.1

# ── Option C: Azure OpenAI ───────────────────────────────────────────────────
# LLM_ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=2024-02-15-preview
# LLM_API_KEY=your-azure-key
# LLM_MODEL_ID=gpt-4o

# Brave Search (optional — not needed for A2A testing)
# BRAVE_API_KEY=BSA-your-key
