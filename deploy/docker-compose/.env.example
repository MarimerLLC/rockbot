# ── LLM Provider ──────────────────────────────────────────────────────────────
# Two options: "Copilot" (GitHub Copilot SDK) or blank/unset (OpenAI-compatible).

# Option A — GitHub Copilot SDK (per-request billing)
# LLM_PROVIDER=Copilot
# GITHUB_TOKEN=ghp_your-token-with-copilot-scope
# LLM_MODEL_ID=gpt-4.1

# Option B — OpenAI-compatible endpoint (per-token billing)
# LLM_PROVIDER=
# LLM_API_KEY=sk-or-v1-your-openrouter-key-here
# LLM_ENDPOINT=https://openrouter.ai/api/v1
# LLM_MODEL_ID=anthropic/claude-sonnet-5.5

# Per-tier overrides. Low already defaults to a cheap model (see docker-compose.yml) because
# it carries the highest-volume, lowest-complexity traffic (patrol subagents, the Dream cycle) —
# leaving it unset does NOT disable it, it just keeps the default below. Only set this if you
# want something other than Claude Haiku 5.5 for that tier.
# LLM_LOW_MODEL_ID=anthropic/claude-haiku-5.5
# High is for escalations/complex tasks and falls back to Balanced when unset.
# LLM_HIGH_MODEL_ID=anthropic/claude-opus-5.5

# REQUIRED — Brave Search API key
BRAVE_API_KEY=BSA-your-brave-key-here

# OPTIONAL — your IANA timezone (defaults to America/Chicago)
# AGENT_TIMEZONE=America/New_York

# OPTIONAL — host path for the agent data volume (soul, memory, skills, etc.)
# When set, agent data is stored in this directory on the host instead of a Docker volume.
# The directory will be created automatically if it doesn't exist.
# AGENT_DATA_PATH=./agent-data

# OPTIONAL — text embedding model for hybrid vector search (BM25 + cosine similarity).
# When configured, memory, skills, and working memory recall improves via vector search.
# Falls back to BM25-only keyword search when not set — no functionality is lost.
# Any OpenAI-compatible embedding endpoint works (OpenAI, Ollama, Azure, etc.)
# EMBEDDING_ENDPOINT=http://host.docker.internal:11434   # Ollama running on the host
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=                                      # not needed for Ollama

# OPTIONAL — Google OAuth sign-in for the Blazor UI.
# Unset, the UI has no sign-in and anything that can reach localhost:8080 can use it.
#
# http://localhost is the one origin Google permits over plain http, so this stack can
# exercise the real flow with no TLS. In the Google Cloud Console create an OAuth 2.0
# "Web application" client and set its authorized redirect URI to exactly:
#     http://localhost:8080/signin-google
# Walkthrough: deploy/blazor-oauth-setup.md
#
# BLAZOR_AUTH_ALLOWED_EMAILS must not be empty when auth is enabled — the app refuses to
# start rather than let every Google account in existence open an agent session.
# BLAZOR_AUTH_ENABLED=true
# BLAZOR_AUTH_PUBLIC_BASE_URL=http://localhost:8080
# BLAZOR_AUTH_GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# BLAZOR_AUTH_GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
# BLAZOR_AUTH_ALLOWED_EMAILS=you@example.com

# OPTIONAL — one Microsoft 365 mailbox via Microsoft Graph (graph-mcp service): mail (read-only),
# calendar and contacts (read/write). The calendar uses AGENT_TIMEZONE above.
# Don't fill these in by hand: deploy/graph/setup.sh --mailbox you@yourdomain creates the Entra
# app, scopes it to that mailbox in Exchange, and writes all of these. See deploy/graph/README.md.
# COMPOSE_PROFILES=graph            # or graph,trello
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SP_OBJECT_ID=
# GRAPH_MAILBOX=you@yourdomain.com
# GRAPH_APP_NAME=RockBot Graph

# OPTIONAL — GitHub's hosted MCP server, read-only (no container). Fine-grained PAT, separate from
# GITHUB_TOKEN. deploy/github/setup.sh prompts for it and registers the server; see deploy/github/README.md.
# GITHUB_MCP_TOKEN=github_pat_...

# OPTIONAL — Trello (trello-mcp service; add "trello" to COMPOSE_PROFILES). deploy/trello/setup.sh
# prompts for the key and token and writes these; see deploy/trello/README.md.
# TRELLO_API_KEY=
# TRELLO_TOKEN=
# TRELLO_ALLOWED_BOARD_IDS=        # comma-separated board ids; empty = every board the token can see

# OPTIONAL — Advisor council (advisor-council + research-agent services; add "council" to
# COMPOSE_PROFILES). No settings of its own: it uses LLM_ENDPOINT/LLM_API_KEY/LLM_MODEL_ID
# (LLM_HIGH_MODEL_ID for the final synthesis) and BRAVE_API_KEY for research. Each request costs
# roughly 5-10 LLM calls and takes 30s-3min; requests are handled one at a time.

# OPTIONAL — Gmail, read + drafts (gmail-mcp service; add "gmail" to COMPOSE_PROFILES).
# deploy/gmail/setup.sh --account NAME writes these, once per account; see deploy/gmail/README.md.
# GMAIL_CLIENT_ID=...apps.googleusercontent.com    # one Google Cloud "Desktop app" OAuth client
# GMAIL_CLIENT_SECRET=
# GMAIL_ACCOUNTS=personal,work                     # the account names RockBot uses
# GMAIL_PERSONAL_EMAIL=you@gmail.com               # one GMAIL_<NAME>_EMAIL and _REFRESH_TOKEN per account
# GMAIL_PERSONAL_REFRESH_TOKEN=

# OPTIONAL — Slack, read-only (slack-mcp service; add "slack" to COMPOSE_PROFILES).
# deploy/slack/setup.sh --workspace NAME writes these, once per workspace; see deploy/slack/README.md.
# SLACK_WORKSPACES=work,acme       # the workspace names RockBot uses
# SLACK_WORK_TOKEN=xoxp-...        # one SLACK_<NAME>_TOKEN and SLACK_<NAME>_TEAM_ID per workspace
# SLACK_WORK_TEAM_ID=T0123ABCD

# OPTIONAL — Obsidian vault (obsidian-sync + obsidian-mcp services; add "obsidian" to COMPOSE_PROFILES).
# Needs an Obsidian Sync subscription. deploy/obsidian/setup.sh signs in, picks the remote vault and
# writes these; see deploy/obsidian/README.md.
# OBSIDIAN_WRITE_FOLDER=RockBot    # the only folder RockBot may create or append notes in
# OBSIDIAN_VAULT_NAME=             # the vault's name in Obsidian, for obsidian:// links in replies

# OPTIONAL — HTTPS + Microsoft sign-in for LAN access (caddy service; add "https" to COMPOSE_PROFILES).
# deploy/https/setup.sh --zone home.example.com writes all of these; see deploy/https/README.md.
# BLAZOR_BIND=127.0.0.1                    # default; 0.0.0.0 exposes plain http on the LAN instead
# RB_DNS_ZONE=home.example.com
# RB_PUBLIC_HOST=rockbot.home.example.com
# CADDY_AZURE_SUBSCRIPTION_ID=
# CADDY_AZURE_RESOURCE_GROUP=rockbot-dns
# CADDY_AZURE_TENANT_ID=
# CADDY_AZURE_CLIENT_ID=
# CADDY_AZURE_CLIENT_SECRET=
# BLAZOR_AUTH_ENABLED=true
# BLAZOR_AUTH_PUBLIC_BASE_URL=https://rockbot.home.example.com
# BLAZOR_AUTH_MICROSOFT_TENANT_ID=
# BLAZOR_AUTH_MICROSOFT_CLIENT_ID=
# BLAZOR_AUTH_MICROSOFT_CLIENT_SECRET=
# BLAZOR_AUTH_ALLOWED_EMAILS=you@example.com
