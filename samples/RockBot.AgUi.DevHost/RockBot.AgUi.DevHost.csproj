<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample code: the real AG-UI proxy with an in-process message bus and a scripted demo agent,
       so the reference client (and its tests) can run without RabbitMQ, an LLM or a cluster
       (#794, phase 6). Development only: it is not deployed, packed or containerized. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RockBot.AgUi.DevHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <StartupObject>RockBot.AgUi.DevHost.DevHostProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- WebApplicationFactory hosts the proxy's own Program, unchanged, and lets this host swap
         RabbitMQ for the in-process bus: the same arrangement the proxy's tests use. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RockBot.UserProxy.AgUi\RockBot.UserProxy.AgUi.csproj" />
    <ProjectReference Include="..\..\src\RockBot.Messaging.InProcess\RockBot.Messaging.InProcess.csproj" />
  </ItemGroup>

</Project>
